---
// Řádky "klíč → hodnota" jednoho panelu. Hodnoty (id v-<id>) doplní JS.
// Řádky s `tech: true` jsou suché technické údaje — schováme je pod
// rozbalovací "technické detaily", ať nahoře zůstane to, co opravdu zarazí.
interface Row { id: string; kCs: string; kEn: string; tech?: boolean }
interface Props { rows: Row[] }
const { rows } = Astro.props;
const main = rows.filter((r) => !r.tech);
const tech = rows.filter((r) => r.tech);
---
<div class="rows">
  {main.map((r) => (
    <div class="row">
      <span class="k"><span class="cs">{r.kCs}</span><span class="en">{r.kEn}</span></span>
      <span class="v pending" id={`v-${r.id}`}>…</span>
    </div>
  ))}
</div>
{tech.length > 0 && (
  <details class="tech">
    <summary>
      <span class="cs">technické detaily ({tech.length})</span>
      <span class="en">technical details ({tech.length})</span>
    </summary>
    <div class="rows">
      {tech.map((r) => (
        <div class="row">
          <span class="k"><span class="cs">{r.kCs}</span><span class="en">{r.kEn}</span></span>
          <span class="v pending" id={`v-${r.id}`}>…</span>
        </div>
      ))}
    </div>
  </details>
)}
