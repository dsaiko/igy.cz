  }
  function renderHeroFacts(){
    var el = document.getElementById('hero-facts'); if (!el) return;
    var f = heroFacts(), key = JSON.stringify(f);
    if (key === heroFactsKey) return;
    // první vykreslení se postupně "vyjede", pozdější doplnění už ne
    if (heroFactsKey) el.classList.add('static');
    heroFactsKey = key;
    el.innerHTML = f.map(function(x, i){
      return '<span class="fact" style="animation-delay:' + (i * 140) + 'ms"><span class="fi">' + x[0] + '</span>' + esc(x[1]) + '</span>';
    }).join('');
  }
  function typeHero(){
    heroTyping = true;
    var lines = heroLines(), li = 0, ci = 0, html = '';
    (function step(){
      if (li >= lines.length){ heroTyping = false; renderHeroFinal(); showCue(); return; }
      var line = lines[li];
      if (ci <= line.length){
        scanEl.innerHTML = html + esc(line.slice(0, ci)) + '<span class="cursor">&nbsp;</span>';
        ci++; setTimeout(step, 24);
      } else {
