    f.push([/iPhone|Android|iPad/.test((gd && gd.name) || navigator.userAgent) ? '📱' : '💻', gd ? gd.name : guessOS()]);
    f.push(['🕘', new Date().toLocaleTimeString(T() === 'en' ? 'en-GB' : 'cs-CZ', { hour: '2-digit', minute: '2-digit' })]);
    var b = S.battery;
    if (b && b.level != null && !b.plugged) f.push(['🔋', b.level + ' %' + (b.charging ? tr(' · nabíjíš', ' · charging') : '')]);
    if (S.sc && S.sc.visits > 1) f.push(['🔁', tr(S.sc.visits + '. návštěva', 'visit #' + S.sc.visits)]);
    if (S.incognito === true) f.push(['🕶️', tr('anonymní okno — nepomůže', 'incognito — won\'t help')]);
