---
import Layout from '../layouts/Layout.astro';
import Rows from '../components/Rows.astro';

// "I Google You" — jedna dlouhá scrollovací stránka. Hero udělá dramatický
// "scan", pak se při scrollu odhalují panely "dossieru": síť, zařízení,
// prohlížeč, otisk (fingerprint) a volitelná svolení. Nic se neukládá — vše
// počítá prohlížeč u tebe, serverová data jen čte /api/whoami. Ven jde jen
// STUN (WebRTC), OSM dlaždice, GoatCounter a po svolení GPS → Nominatim.

// Helper: jeden řádek "klíč → hodnota" s místem (id), které doplní JS.
// tech = suchý technický údaj → schová se pod "technické detaily".
const Row = (id: string, kCs: string, kEn: string, tech = false) => ({ id, kCs, kEn, tech });

const netRows = [
  Row('ip', 'IP adresa', 'IP address'),
  Row('city', 'Město', 'City'),
  Row('region', 'Region', 'Region'),
  Row('country', 'Země', 'Country'),
  Row('isp', 'Operátor / ASN', 'ISP / ASN'),
  Row('vpn', 'VPN / proxy', 'VPN / proxy'),
  Row('rtc-local', 'Lokální IP (WebRTC)', 'Local IP (WebRTC)'),
  Row('rtc-public', 'Veřejná IP (STUN)', 'Public IP (STUN)'),
  Row('ipver', 'Verze IP', 'IP version', true),
  Row('conn', 'Typ připojení', 'Connection type', true),
  Row('colo', 'Prošel jsi přes', 'You routed via', true),
  Row('proto', 'Protokol', 'Protocol', true),
  Row('tls', 'TLS', 'TLS', true),
  Row('rtt', 'Latence k uzlu', 'Latency to node', true),
];
// Signály pro triangulaci původu (panel 05). Texty řádků doplní JS.
const originRows = [
  Row('o-ip', 'Podle IP', 'By IP'),
  Row('o-tz', 'Časové pásmo', 'Time zone'),
  Row('o-lang', 'Jazyk prohlížeče', 'Browser language'),
  Row('o-kbd', 'Klávesnice', 'Keyboard layout'),
  Row('o-adblock', 'Adblock', 'Adblock'),
  Row('o-adregion', 'Regionální filtr', 'Regional filter'),
  Row('o-locale', 'Formát čísel', 'Number format', true),
];
const behaviorRows = [
  Row('b-time', 'Čas na stránce', 'Time on page'),
  Row('b-mouse', 'Pohyby myši', 'Mouse moves'),
  Row('b-dist', 'Ujetá vzdálenost', 'Distance travelled'),
  Row('b-clicks', 'Kliknutí', 'Clicks'),
  Row('b-keys', 'Stisky kláves', 'Keystrokes'),
  Row('b-scroll', 'Kam jsi doscrolloval', 'How far you scrolled'),
  Row('b-away', 'Kolikrát ses koukl jinam', 'Times you looked away'),
  Row('b-copy', 'Co sis zkopíroval', 'What you copied'),
];
const deviceRows = [
  Row('device-guess', 'Odhad zařízení', 'Best-guess device'),
  Row('os', 'Systém', 'OS'),
  Row('battery', 'Baterie', 'Battery'),
  Row('cores', 'Jádra CPU', 'CPU cores'),
  Row('ram', 'Paměť (min.)', 'Memory (min.)'),
  Row('gpu', 'Grafika (GPU)', 'Graphics (GPU)'),
  Row('screen', 'Obrazovka', 'Screen'),
  Row('monitors', 'Monitory', 'Monitors'),
  Row('media-cam', 'Připojené kamery', 'Cameras attached'),
  Row('media-mic', 'Připojené mikrofony', 'Mics attached'),
  Row('platform', 'Platforma', 'Platform', true),
  Row('touch', 'Dotykové body', 'Touch points', true),
  Row('viewport', 'Okno', 'Viewport', true),
  Row('dpr', 'Pixel ratio', 'Pixel ratio', true),
  Row('depth', 'Barevná hloubka', 'Color depth', true),
];
const browserRows = [
  Row('browser', 'Prohlížeč', 'Browser'),
  Row('incognito', 'Anonymní okno', 'Incognito window'),
  Row('langs', 'Jazyky', 'Languages'),
  Row('tz', 'Časové pásmo', 'Time zone'),
  Row('localtime', 'Tvůj čas', 'Your time'),
  Row('prefs', 'Tvoje nastavení', 'Your settings'),
  Row('dnt', 'Do Not Track', 'Do Not Track'),
  Row('engine', 'Jádro', 'Engine', true),
  Row('locale', 'Formát čísel', 'Number format', true),
  Row('cookies', 'Cookies', 'Cookies', true),
  Row('ua', 'User-Agent', 'User-Agent', true),
];
const fpRows = [
  Row('fp-canvas', 'Canvas otisk', 'Canvas hash'),
  Row('fp-webgl', 'WebGL otisk', 'WebGL hash'),
  Row('fp-audio', 'Audio otisk', 'Audio hash'),
  Row('fp-fonts', 'Detekované fonty', 'Detected fonts'),
  Row('fp-software', 'Software podle fontů', 'Software from fonts'),
];
---
<Layout
  titleCs="I Google You — vidím tě"
  titleEn="I Google You — I can see you">

<style is:global>
  /* ---------- Layout sekcí ---------- */
  main { width: 100%; }
  .wrap { width: min(880px, 92vw); margin: 0 auto; }

  /* ---------- HERO ---------- */
  .hero {
    min-height: 100svh; display: flex; flex-direction: column;
    align-items: center; justify-content: center; text-align: center;
    padding: 80px 20px 40px; position: relative;
  }
  .eyebrow {
    font-family: var(--mono); font-size: 12px; letter-spacing: .32em;
    text-transform: uppercase; color: var(--accent); margin-bottom: 26px;
    display: inline-flex; align-items: center; gap: 10px;
  }
  .eyebrow .dot {
    width: 7px; height: 7px; border-radius: 50%; background: var(--accent);
    box-shadow: 0 0 10px var(--accent); animation: pulse 1.6s ease-in-out infinite;
  }
  @keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.35;transform:scale(.7)} }

  .hero h1 {
    font-size: clamp(40px, 9vw, 92px); line-height: .98; font-weight: 800;
    letter-spacing: -0.035em; margin: 0; max-width: 14ch;
    background: linear-gradient(180deg, #fff 30%, #9fb0bd 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .hero h1 .hl { color: var(--danger); -webkit-text-fill-color: var(--danger); }

  .scanline {
    font-family: var(--mono); font-size: clamp(14px, 2.4vw, 19px); color: var(--ink-dim);
    margin: 30px 0 0; min-height: 1.6em;
  }
  .scanline b { color: var(--accent); font-weight: 600; }
  .scanline .cursor {
    display: inline-block; width: .6ch; background: var(--accent); margin-left: 1px;
    animation: blink 1s step-end infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }

  .scrollcue {
    position: absolute; bottom: 26px; left: 50%; transform: translateX(-50%);
    font-family: var(--mono); font-size: 12px; letter-spacing: .2em; text-transform: uppercase;
    color: var(--accent); display: flex; flex-direction: column; align-items: center; gap: 12px;
    opacity: 0; transition: opacity .6s; animation: floaty 1.8s ease-in-out infinite;
    text-shadow: 0 0 18px rgba(56,232,200,0.5);
  }
  .scrollcue.show { opacity: 1; }
  .scrollcue .arrow {
    display: flex; align-items: center; justify-content: center;
    width: 34px; height: 34px; border-radius: 50%; font-size: 18px;
    border: 1px solid var(--accent); color: var(--accent);
    box-shadow: 0 0 20px rgba(56,232,200,0.35); background: rgba(56,232,200,0.06);
  }
  @keyframes floaty { 0%,100%{transform:translate(-50%,0)} 50%{transform:translate(-50%,8px)} }

  /* ---------- PANELY (dossier) ---------- */
  .panel { padding: 60px 0; }
  .panel-card {
    border: 1px solid var(--panel-border); border-radius: 18px;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.03), rgba(255,255,255,0.008));
    overflow: hidden; position: relative;
    opacity: 0; transform: translateY(34px); filter: blur(6px);
    transition: opacity .7s ease, transform .7s cubic-bezier(.2,.7,.2,1), filter .7s;
  }
  .panel-card.in { opacity: 1; transform: none; filter: none; }
  .panel-card::before { /* horní accent linka */
    content: ""; position: absolute; top: 0; left: 0; right: 0; height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent-dim), transparent);
  }

  .panel-head {
    display: flex; align-items: center; gap: 14px; padding: 20px 24px;
    border-bottom: 1px solid var(--panel-border);
  }
  .panel-num {
    font-family: var(--mono); font-size: 12px; color: var(--accent);
    border: 1px solid var(--accent-dim); border-radius: 6px; padding: 3px 7px;
  }
  .panel-title { font-size: 17px; font-weight: 700; letter-spacing: -0.01em; margin: 0; }
  .panel-sub { font-size: 13px; color: var(--ink-dim); margin-left: auto; text-align: right; }

  .rows { display: grid; grid-template-columns: 1fr; }
  .row {
    display: grid; grid-template-columns: minmax(120px, 38%) 1fr; gap: 16px;
    padding: 13px 24px; border-bottom: 1px solid rgba(255,255,255,0.045);
    font-size: 14px; align-items: baseline;
  }
  .row:last-child { border-bottom: none; }
  .row .k { color: var(--ink-dim); }
  .row .v {
    font-family: var(--mono); color: var(--ink); word-break: break-word;
    opacity: 0; transform: translateY(4px); transition: opacity .4s, transform .4s;
  }
  .panel-card.in .row .v { opacity: 1; transform: none; }
  .row .v.pending { color: var(--ink-faint); }
  .row .v.hot { color: var(--amber); }
  .row .v.danger { color: var(--danger); }
  .row .v small { color: var(--ink-faint); font-size: 12px; }

  /* Intro každého panelu */
  .lead { font-size: 15px; line-height: 1.65; color: var(--ink-dim); margin: 0 0 26px; }
  .lead b { color: var(--ink); font-weight: 600; }

  /* ---------- Fingerprint verdikt ---------- */
  .fp-verdict {
    margin-top: 18px; padding: 24px; border-radius: 16px;
    border: 1px solid rgba(255,92,108,0.3); background: rgba(255,92,108,0.06);
    text-align: center;
  }
  .fp-id {
    font-family: var(--mono); font-size: clamp(20px, 5vw, 34px); font-weight: 700;
    color: var(--danger); letter-spacing: .04em; word-break: break-all;
  }
  .fp-verdict p { color: var(--ink-dim); font-size: 14px; margin: 14px 0 0; line-height: 1.6; }
  .incognito {
    display: inline-flex; align-items: center; gap: 10px; margin: 18px auto 0;
    padding: 11px 20px; border-radius: 999px;
    border: 1px solid rgba(56,232,200,0.4); background: rgba(56,232,200,0.08);
    font-family: var(--mono); font-size: 14px; font-weight: 600; color: var(--accent);
    box-shadow: 0 0 26px rgba(56,232,200,0.12);
  }
  .incognito .ic { font-size: 17px; filter: grayscale(1) brightness(1.6); }
  .incognito-try { color: var(--ink-faint) !important; font-size: 12.5px !important; margin-top: 12px !important; }
  .sc-box {
    margin-top: 14px; padding: 22px; border-radius: 16px; text-align: center;
    border: 1px solid rgba(255,184,77,0.3); background: rgba(255,184,77,0.06);
  }
  .sc-tag { font-family: var(--mono); font-size: 12px; letter-spacing: .06em; color: var(--amber); margin-bottom: 12px; }
  .sc-box .fp-id { color: var(--amber); font-size: clamp(18px, 4.5vw, 28px); }
  .sc-box .fp-id.danger { color: var(--danger); }
  .sc-box p { color: var(--ink-dim); font-size: 14px; margin: 12px 0 0; line-height: 1.6; }
  .sc-box p b { color: var(--ink); }
  .fp-bar { height: 4px; border-radius: 999px; background: rgba(255,255,255,0.07); overflow: hidden; margin: 0 0 18px; }
  .fp-bar i { display: block; height: 100%; width: 0; background: linear-gradient(90deg, var(--accent), var(--danger)); transition: width .5s ease; }

  /* ---------- Volitelná svolení ---------- */
  .perm-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: 12px; }
  .perm {
    text-align: left; border: 1px solid var(--panel-border); border-radius: 14px;
    background: rgba(255,255,255,0.02); padding: 16px; cursor: pointer; color: var(--ink);
    font-family: inherit; transition: border-color .15s, background .15s, transform .05s;
  }
  .perm:hover { border-color: var(--accent-dim); background: rgba(56,232,200,0.05); }
  .perm:active { transform: scale(.98); }
  .perm .pi { font-size: 22px; }
  .perm .pt { font-weight: 700; font-size: 14px; margin: 8px 0 4px; }
  .perm .pd { font-size: 12.5px; color: var(--ink-dim); line-height: 1.5; }
  .perm .pr { font-family: var(--mono); font-size: 12.5px; color: var(--accent); margin-top: 10px; min-height: 1.2em; word-break: break-word; }
  .perm .pr.danger { color: var(--danger); }

  /* ---------- Geo reticle (mapa podle IP) ---------- */
  .geo-wrap { padding: 8px 24px 22px; }
  .geo-stack { position: relative; border-radius: 12px; overflow: hidden;
    border: 1px solid var(--panel-border); background: #05070a; aspect-ratio: 760 / 240; }
  #geo-map-frame { position: absolute; inset: 0; width: 100%; height: 100%; border: 0;
    pointer-events: none; filter: grayscale(.35) brightness(.62) contrast(1.05); }
  .geo-tint { position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(circle at 50% 50%, rgba(56,232,200,0.12), transparent 55%),
      linear-gradient(180deg, rgba(5,7,10,0.35), rgba(5,7,10,0.55)); }
  #geo-map { position: absolute; inset: 0; width: 100%; height: 100%; display: block; pointer-events: none; }
  .geo-cap { display: flex; justify-content: space-between; align-items: center; gap: 12px;
    margin-top: 10px; font-family: var(--mono); font-size: 12.5px; color: var(--ink-dim); }
  .geo-cap a { color: var(--accent); text-decoration: none; border-bottom: 1px solid var(--accent-dim); white-space: nowrap; }
  .geo-cap a:hover { color: #fff; }

  /* ---------- Přesná GPS mapa (panel Svolení) ---------- */
  #geo-precise { margin-top: 16px; }
  #geo-precise-map { width: 100%; height: 260px; border: 1px solid var(--panel-border);
    border-radius: 14px; filter: grayscale(.25) brightness(.72) contrast(1.05); }
  .geo-addr { margin-top: 10px; font-family: var(--mono); font-size: 13px; color: var(--danger);
    line-height: 1.5; word-break: break-word; }

  /* ---------- Retro ---------- */
  .retro-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px,1fr)); gap: 10px; }
  .retro {
    border: 1px solid var(--panel-border); border-radius: 12px; padding: 14px;
    background: rgba(255,255,255,0.015);
  }
  .retro .rn { font-weight: 700; font-size: 14px; }
  .retro .rs { font-family: var(--mono); font-size: 11px; color: var(--danger); text-transform: uppercase; letter-spacing: .08em; }
  .retro .rd { font-size: 12.5px; color: var(--ink-dim); margin-top: 6px; line-height: 1.5; }

  /* ---------- Outro ---------- */
  .outro { text-align: center; padding: 90px 20px 70px; }
  .outro h2 { font-size: clamp(26px, 5vw, 40px); font-weight: 800; letter-spacing: -0.02em; margin: 0 0 18px; }
  .outro p { color: var(--ink-dim); font-size: 15px; line-height: 1.7; max-width: 60ch; margin: 0 auto 14px; }
  .privacy {
    display: inline-flex; align-items: center; gap: 9px; margin-top: 14px; padding: 10px 18px;
    border: 1px solid var(--accent-dim); border-radius: 999px; color: var(--accent);
    font-family: var(--mono); font-size: 13px;
  }
  .footer-link { margin-top: 34px; display: flex; gap: 22px; justify-content: center; }
  .footer-link a { color: var(--ink-dim); text-decoration: none; font-size: 13px; border-bottom: 1px solid var(--ink-faint); }
  .footer-link a:hover { color: var(--accent); border-color: var(--accent); }

  .section-label {
    font-family: var(--mono); font-size: 12px; letter-spacing: .26em; text-transform: uppercase;
    color: var(--accent); margin: 0 0 16px; display: block;
  }

  /* ---------- Finální spis (dossier) ---------- */
  .dossier {
    width: min(680px, 100%); margin: 30px auto 10px; text-align: left;
    border: 1px solid rgba(255,92,108,0.28); border-radius: 16px; overflow: hidden;
    background: linear-gradient(180deg, rgba(255,92,108,0.05), rgba(255,255,255,0.008));
    opacity: 0; transform: translateY(28px) scale(.99); filter: blur(6px);
    transition: opacity .8s ease, transform .8s cubic-bezier(.2,.7,.2,1), filter .8s;
  }
  .dossier.in { opacity: 1; transform: none; filter: none; }
  .dossier-head {
    display: flex; align-items: center; gap: 12px; padding: 14px 20px;
    border-bottom: 1px solid rgba(255,92,108,0.2); font-family: var(--mono); font-size: 12px;
    letter-spacing: .14em; color: var(--ink-dim);
  }
  .ds-rec { color: var(--danger); font-weight: 700; animation: pulse 1.6s ease-in-out infinite; }
  .ds-title { color: var(--ink); }
  .ds-code { margin-left: auto; color: var(--danger); }
  .dossier-grid { padding: 6px 20px; }
  .ds-row { display: grid; grid-template-columns: 40% 1fr; gap: 12px; padding: 11px 0;
    border-bottom: 1px solid rgba(255,255,255,0.045); font-size: 14px; align-items: baseline; }
  .ds-row:last-child { border-bottom: none; }
  .ds-k { color: var(--ink-dim); font-size: 12.5px; text-transform: uppercase; letter-spacing: .04em; }
  .ds-v { font-family: var(--mono); color: var(--ink); word-break: break-word; }
  .ds-track { padding: 20px; text-align: center; border-top: 1px solid rgba(255,92,108,0.2);
    background: rgba(255,92,108,0.06); }
  .ds-track-label { font-family: var(--mono); font-size: 11px; letter-spacing: .22em; color: var(--ink-dim); }
  .ds-track-val { font-family: var(--mono); font-size: clamp(22px, 5vw, 34px); font-weight: 800;
    color: var(--danger); margin: 8px 0 6px; }
  .ds-track-note { color: var(--ink-dim); font-size: 13px; line-height: 1.55; max-width: 52ch; margin: 0 auto; }

  /* ---------- HERO fakta (velká personalizace hned na první obrazovce) ---------- */
  .hero-facts {
    display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 12px;
    max-width: 780px; margin: 26px auto 0; min-height: 1px;
  }
  .fact {
    font-family: var(--mono); font-size: clamp(15px, 2.3vw, 21px); font-weight: 600;
    color: var(--ink); padding: 8px 14px; border-radius: 999px;
    border: 1px solid rgba(255,92,108,0.35); background: rgba(255,92,108,0.07);
    opacity: 0; transform: translateY(8px); animation: factIn .5s ease forwards;
  }
  .fact .fi { filter: saturate(0.9); margin-right: 6px; }
  .hero-facts.static .fact { animation: none; opacity: 1; transform: none; }
  @keyframes factIn { to { opacity: 1; transform: none; } }

  /* ---------- "co z toho plyne" ---------- */
  .sowhat {
    margin: 0; padding: 16px 24px 18px 22px; font-size: 14.5px; line-height: 1.6;
    color: var(--ink); border-top: 1px solid var(--panel-border);
    border-left: 3px solid var(--danger); background: rgba(255,92,108,0.045);
  }
  .sowhat::before { content: "→ "; color: var(--danger); font-weight: 700; }

  /* ---------- technické detaily (rozbalovací) ---------- */
  details.tech { border-top: 1px solid rgba(255,255,255,0.045); }
  details.tech summary {
    cursor: pointer; list-style: none; padding: 11px 24px; font-family: var(--mono);
    font-size: 12px; letter-spacing: .06em; color: var(--ink-faint);
  }
  details.tech summary::-webkit-details-marker { display: none; }
  details.tech summary::after { content: " ▾"; }
  details.tech[open] summary::after { content: " ▴"; }
  details.tech summary:hover { color: var(--accent); }

  /* ---------- heatmapa kurzoru ---------- */
  .heat-wrap { padding: 6px 24px 20px; }
  .heat-wrap .geo-cap { justify-content: center; text-align: center; }
  #heat { width: 100%; max-width: 560px; margin: 0 auto; height: auto; display: block; border-radius: 12px;
    border: 1px solid var(--panel-border); background: #05070a; }

  /* ---------- kamera: náhled + zmrazený snímek ---------- */
  .cam-box { position: relative; margin-top: 16px; border-radius: 14px; overflow: hidden;
    border: 1px solid rgba(255,92,108,0.4); background: #000; max-width: 480px; }
  .cam-box video, .cam-box canvas { display: block; width: 100%; height: auto; transform: scaleX(-1); }
  .cam-tag { position: absolute; top: 10px; left: 12px; font-family: var(--mono); font-size: 12px;
    color: #fff; text-shadow: 0 0 6px #000; }
  .cam-cap { padding: 10px 14px; font-family: var(--mono); font-size: 12.5px; color: var(--danger);
    background: rgba(7,8,9,0.85); line-height: 1.5; }
  .perm:disabled { cursor: progress; opacity: .7; }

  /* ---------- retro → dnes ---------- */
  .retro .rnow { font-family: var(--mono); font-size: 11.5px; color: var(--amber); margin-top: 8px; line-height: 1.45; }

  /* ---------- spis: hlášení ---------- */
  /* .dossier prefix: jinak by vyhrálo obecné `.outro p` (max-width, margin auto) */
  .dossier .ds-story { margin: 0; max-width: none; padding: 16px 20px; font-size: 14.5px; line-height: 1.7;
    color: var(--ink); border-bottom: 1px solid rgba(255,92,108,0.2); }
  .ds-story b { color: var(--danger); font-weight: 700; }

  /* ---------- co s tím ---------- */
  .defend { width: min(880px, 100%); margin: 56px auto 10px; text-align: left;
    opacity: 0; transform: translateY(24px); transition: opacity .7s ease, transform .7s cubic-bezier(.2,.7,.2,1); }
  .defend.in { opacity: 1; transform: none; }
  .defend .section-label { text-align: center; }
  .defend-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 12px; }
  .tip { border: 1px solid rgba(56,232,200,0.22); border-radius: 14px; padding: 16px; background: rgba(56,232,200,0.035); }
  .tip .tt { font-weight: 700; font-size: 14.5px; margin-bottom: 6px; color: var(--ink); }
  .tip .td { font-size: 13px; color: var(--ink-dim); line-height: 1.55; }

  /* ---------- sdílení + toast ---------- */
  .share { margin: 30px auto 0; }
  #share-btn { font: inherit; font-size: 14px; font-weight: 600; color: var(--bg); background: var(--accent);
    border: none; border-radius: 999px; padding: 12px 22px; cursor: pointer; box-shadow: 0 0 26px rgba(56,232,200,0.25); }
  #share-btn:hover { filter: brightness(1.08); }
  .share-note { margin-top: 10px; min-height: 1.2em; font-family: var(--mono); font-size: 12.5px; color: var(--accent); }
  .toast { position: fixed; left: 50%; bottom: 22px; transform: translate(-50%, 20px); z-index: 60;
    max-width: min(560px, calc(100vw - 32px)); padding: 12px 18px; border-radius: 14px;
    background: rgba(13,15,18,0.96); border: 1px solid rgba(255,92,108,0.45); color: var(--ink);
    font-size: 14px; line-height: 1.5; box-shadow: 0 10px 40px rgba(0,0,0,0.5);
    opacity: 0; transition: opacity .3s, transform .3s; pointer-events: none; }
  .toast.show { opacity: 1; transform: translate(-50%, 0); }
  .toast b { color: var(--danger); }
</style>

<main>
  <noscript>
    <div style="max-width:680px;margin:80px auto;padding:0 20px;text-align:center;font-family:var(--sans);">
      <p style="font-size:20px;color:var(--ink);font-weight:700;">
        <span class="cs">igy.cz běží na JavaScriptu.</span>
        <span class="en">igy.cz runs on JavaScript.</span>
      </p>
      <p style="color:var(--ink-dim);line-height:1.6;">
        <span class="cs">Máš ho vypnutý — a to je paradoxně nejlepší obrana proti tomu, co tenhle web ukazuje. Zapni ho, jestli chceš vidět, co o tobě prohlížeč prozradí.</span>
        <span class="en">You've turned it off — which is ironically the best defense against what this site demonstrates. Enable it to see what your browser reveals about you.</span>
      </p>
    </div>
  </noscript>

  <!-- ============ HERO ============ -->
  <section class="hero">
    <span class="eyebrow"><span class="dot"></span> igy.cz · I Google You</span>
    <h1>
      <span class="cs">Myslíš, že jsi tu <span class="hl">anonymně?</span></span>
      <span class="en">Think you're here <span class="hl">anonymously?</span></span>
    </h1>
    <p class="scanline" id="scanline"><span class="cursor">&nbsp;</span></p>
    <div class="hero-facts" id="hero-facts" aria-live="polite"></div>
    <div class="scrollcue" id="scrollcue">
      <span class="cs">scrolluj — uvidíš, co o tobě vím</span>
      <span class="en">scroll — see what I know about you</span>
      <span class="arrow">↓</span>
    </div>
  </section>

  <!-- ============ 01 · SÍŤ ============ -->
  <section class="panel"><div class="wrap"><div class="panel-card" data-panel>
    <div class="panel-head">
      <span class="panel-num">01</span>
      <h2 class="panel-title"><span class="cs">Síť</span><span class="en">Network</span></h2>
      <span class="panel-sub"><span class="cs">co vidí server</span><span class="en">what the server sees</span></span>
    </div>
    <Rows rows={netRows} />
    <div class="geo-wrap" id="geo-wrap" hidden>
      <div class="geo-stack">
        <iframe id="geo-map-frame" title="map" loading="lazy" referrerpolicy="no-referrer"></iframe>
        <div class="geo-tint"></div>
        <canvas id="geo-map" width="760" height="240"></canvas>
      </div>
      <div class="geo-cap">
        <span id="geo-cap-txt"></span>
        <a id="geo-osm" href="#" target="_blank" rel="noopener noreferrer">
          <span class="cs">otevřít v mapě →</span><span class="en">open in map →</span>
        </a>
      </div>
    </div>
    <p class="sowhat" id="sw-net">
      <span class="cs">Z IP vím město a operátora. A operátor ví přesně, komu tahle IP právě patří — jméno i adresu.</span>
      <span class="en">From your IP I get your city and ISP. And your ISP knows exactly who this IP belongs to right now — name and address.</span>
    </p>
  </div></div></section>

  <!-- ============ 02 · ZAŘÍZENÍ ============ -->
  <section class="panel"><div class="wrap"><div class="panel-card" data-panel>
    <div class="panel-head">
      <span class="panel-num">02</span>
      <h2 class="panel-title"><span class="cs">Zařízení</span><span class="en">Device</span></h2>
      <span class="panel-sub"><span class="cs">tvůj hardware</span><span class="en">your hardware</span></span>
    </div>
    <Rows rows={deviceRows} />
    <p class="sowhat">
      <span class="cs">Podle hardwaru odhadnu, co máš za zařízení a kolik zhruba stálo. Tohle se opravdu používá: cestovní web Orbitz ukazoval majitelům Maců dražší hotely.</span>
      <span class="en">From your hardware I can guess your device and roughly what it cost. This is used for real: travel site Orbitz showed Mac users pricier hotels.</span>
    </p>
  </div></div></section>

  <!-- ============ 03 · PROHLÍŽEČ ============ -->
  <section class="panel"><div class="wrap"><div class="panel-card" data-panel>
    <div class="panel-head">
      <span class="panel-num">03</span>
      <h2 class="panel-title"><span class="cs">Prohlížeč</span><span class="en">Browser</span></h2>
      <span class="panel-sub"><span class="cs">software a nastavení</span><span class="en">software & settings</span></span>
    </div>
    <Rows rows={browserRows} />
    <p class="sowhat">
      <span class="cs">Jazyk, časové pásmo a nastavení prozradí, odkud jsi a jak žiješ — ať IP tvrdí cokoli. A Do Not Track? Většina webů ho prostě ignoruje.</span>
      <span class="en">Language, time zone and settings reveal where you're from and how you live — whatever your IP says. And Do Not Track? Most sites simply ignore it.</span>
    </p>
  </div></div></section>

  <!-- ============ 04 · OTISK ============ -->
  <section class="panel"><div class="wrap"><div class="panel-card" data-panel>
    <div class="panel-head">
      <span class="panel-num">04</span>
      <h2 class="panel-title"><span class="cs">Otisk</span><span class="en">Fingerprint</span></h2>
      <span class="panel-sub"><span class="cs">tiché stopy</span><span class="en">silent traces</span></span>
    </div>
    <div style="padding: 20px 24px 4px;">
      <p class="lead" style="margin-bottom:18px;">
        <span class="cs">Tohle nepotřebuje cookies ani přihlášení. Tvůj prohlížeč kreslí grafiku
        a přehrává zvuk nepatrně jinak než kterýkoli jiný — z těch rozdílů jde složit
        <b>skoro unikátní otisk</b>, který tě pozná i v anonymním okně.</span>
        <span class="en">No cookies, no login. Your browser draws graphics and plays audio
        slightly differently from every other one — those differences combine into an
        <b>almost-unique fingerprint</b> that recognizes you even in incognito.</span>
      </p>
    </div>
    <Rows rows={fpRows} />
    <div style="padding: 20px 24px 24px;">
      <div class="fp-bar"><i id="fp-progress"></i></div>
      <div class="fp-verdict">
        <div class="fp-id" id="fp-id">· · · · · · · ·</div>
        <p>
          <span class="cs">Tohle je tvoje ID — složené jen z vlastností tvého prohlížeče a zařízení.</span>
          <span class="en">This is your ID — built only from your browser and device traits.</span>
        </p>
        <div class="incognito">
          <span class="ic">🕶️</span>
          <span class="cs">Nezmění se ani v anonymním okně.</span>
          <span class="en">It won't change in incognito either.</span>
        </div>
        <p class="incognito-try">
          <span class="cs">Nevěříš? Otevři igy.cz v anonymním okně a porovnej ID.</span>
          <span class="en">Don't believe it? Open igy.cz in incognito and compare the ID.</span>
        </p>
        <p class="incognito-try" style="margin-top:6px;">
          <span class="cs">Výjimka: na iOS Safari se ID může měnit — Apple do otisku schválně přidává šum.</span>
          <span class="en">Exception: on iOS Safari the ID may change — Apple deliberately adds anti-fingerprinting noise.</span>
        </p>
      </div>

      <div class="sc-box" id="sc-box">
        <div class="sc-tag">
          <span class="cs">🍪 SUPERCOOKIE · ETag — přežije smazání cookies</span>
          <span class="en">🍪 SUPERCOOKIE · ETag — survives a cookie wipe</span>
        </div>
        <div class="fp-id" id="sc-id">· · ·</div>
        <p id="sc-note">
          <span class="cs">Ptám se serveru…</span>
          <span class="en">Asking the server…</span>
        </p>
      </div>
    </div>
    <p class="sowhat">
      <span class="cs">Smazání cookies ani anonymní okno nepomůžou: otisk se spočítá znovu a vyjde stejně. Používají ho reklamní sítě i antifraud systémy bank.</span>
      <span class="en">Clearing cookies or going incognito won't help: the fingerprint is simply recomputed — and comes out the same. Ad networks and banks' anti-fraud systems use it.</span>
    </p>
  </div></div></section>

  <!-- ============ 05 · PŮVOD ============ -->
  <section class="panel"><div class="wrap"><div class="panel-card" data-panel>
    <div class="panel-head">
      <span class="panel-num">05</span>
      <h2 class="panel-title"><span class="cs">Odkud doopravdy jsi</span><span class="en">Where you really are</span></h2>
      <span class="panel-sub"><span class="cs">křížím signály</span><span class="en">cross-checking signals</span></span>
    </div>
    <div style="padding: 20px 24px 4px;">
      <p class="lead" style="margin-bottom:18px;">
        <span class="cs">Jeden údaj se dá zamlžit. Ale když jich složím víc dohromady,
        zbude málo místa pro pochybnost — <b>každý řádek hlasuje pro jednu zemi</b>.</span>
        <span class="en">A single data point can be faked. But stack several together and
        there's little room for doubt — <b>each row votes for one country</b>.</span>
      </p>
    </div>
    <Rows rows={originRows} />
    <div style="padding: 20px 24px 24px;">
      <div class="fp-verdict" style="border-color: rgba(56,232,200,0.3); background: rgba(56,232,200,0.06);">
        <div class="fp-id" id="origin-verdict" style="color: var(--accent);">· · ·</div>
        <p id="origin-note">
          <span class="cs">Triangulace běží…</span>
          <span class="en">Triangulating…</span>
        </p>
      </div>
    </div>
    <p class="sowhat">
      <span class="cs">VPN změní jen jeden hlas z mnoha. Hodiny, jazyk a klávesnice tě prozradí dál.</span>
      <span class="en">A VPN changes just one vote out of many. Your clock, language and keyboard still give you away.</span>
    </p>
  </div></div></section>

  <!-- ============ 06 · CHOVÁNÍ ============ -->
  <section class="panel"><div class="wrap"><div class="panel-card" data-panel>
    <div class="panel-head">
      <span class="panel-num">06</span>
      <h2 class="panel-title"><span class="cs">Sleduju tě. Právě teď.</span><span class="en">I'm watching you. Right now.</span></h2>
      <span class="panel-sub"><span class="cs">v reálném čase</span><span class="en">in real time</span></span>
    </div>
    <div style="padding: 20px 24px 4px;">
      <p class="lead" style="margin-bottom:18px;">
        <span class="cs">Tohle běží od chvíle, kdy jsi web otevřel — bez ptaní. Každý pohyb,
        každé kliknutí, i to, <b>kdy ses přepnul do jiného okna</b>.</span>
        <span class="en">This has run since you opened the page — no asking. Every move,
        every click, even <b>when you switched to another window</b>.</span>
      </p>
    </div>
    <Rows rows={behaviorRows} />
    <div class="heat-wrap">
      <canvas id="heat" width="760" height="300" aria-label="mouse heatmap"></canvas>
      <div class="geo-cap"><span>
        <span class="cs">Tvůj kurzor v tomhle okně (zmenšeno) — kde ses zdržel a kam jsi klikl.</span>
        <span class="en">Your cursor in this window (scaled down) — where you lingered and where you clicked.</span>
      </span></div>
    </div>
    <p class="sowhat">
      <span class="cs">Nástroje na „nahrávání relací" (Hotjar, Microsoft Clarity…) tohle ukládají na spoustě běžných webů — i s tím, kde ses zarazil a co jsi vyplnil a zase smazal.</span>
      <span class="en">"Session replay" tools (Hotjar, Microsoft Clarity…) record exactly this on plenty of ordinary sites — including where you hesitated and what you typed and deleted.</span>
    </p>
  </div></div></section>

  <!-- ============ 07 · SVOLENÍ ============ -->
  <section class="panel"><div class="wrap"><div class="panel-card" data-panel>
    <div class="panel-head">
      <span class="panel-num">07</span>
      <h2 class="panel-title"><span class="cs">A když dovolíš…</span><span class="en">And if you allow…</span></h2>
      <span class="panel-sub"><span class="cs">jediné kliknutí</span><span class="en">one click each</span></span>
    </div>
    <div style="padding: 22px 24px;">
      <p class="lead">
        <span class="cs">Všechno nahoře šlo <b>bez tvého svolení</b>. Tohle je za jedním kliknutím —
        zkus, jak málo stačí.</span>
        <span class="en">Everything above worked <b>without your consent</b>. These are one click away —
        see how little it takes.</span>
      </p>
      <div class="perm-grid">
        <button class="perm" id="perm-geo">
          <div class="pi">📍</div>
          <div class="pt"><span class="cs">Přesná poloha</span><span class="en">Precise location</span></div>
          <div class="pd"><span class="cs">GPS na metry, ne podle IP</span><span class="en">GPS to the metre, not by IP</span></div>
          <div class="pr" id="pr-geo"></div>
        </button>
        <button class="perm" id="perm-cam">
          <div class="pi">📷</div>
          <div class="pt"><span class="cs">Kamera</span><span class="en">Camera</span></div>
          <div class="pd"><span class="cs">Co tvoje kamera právě vidí</span><span class="en">What your camera sees right now</span></div>
          <div class="pr" id="pr-cam"></div>
        </button>
        <button class="perm" id="perm-mic">
          <div class="pi">🎙️</div>
          <div class="pt"><span class="cs">Mikrofon</span><span class="en">Microphone</span></div>
          <div class="pd"><span class="cs">Hladina zvuku v reálném čase</span><span class="en">Live audio level</span></div>
          <div class="pr" id="pr-mic"></div>
        </button>
      </div>
      <div class="cam-box" id="cam-box" hidden>
        <video id="cam-video" playsinline muted></video>
        <canvas id="cam-still" hidden></canvas>
        <div class="cam-tag"><span class="ds-rec">● REC</span> <span id="cam-count"></span></div>
        <div class="cam-cap" id="cam-cap">
          <span class="cs">Tohle vidím já.</span><span class="en">This is what I see.</span>
        </div>
      </div>

      <div id="geo-precise" hidden>
        <iframe id="geo-precise-map" title="map" loading="lazy" referrerpolicy="no-referrer"></iframe>
        <div id="geo-precise-addr" class="geo-addr"></div>
        <div class="geo-cap">
          <span><span class="cs">Přesně tady jsi.</span><span class="en">This is exactly where you are.</span></span>
          <a id="geo-precise-link" href="#" target="_blank" rel="noopener noreferrer">
            <span class="cs">otevřít v mapách →</span><span class="en">open in maps →</span>
          </a>
        </div>
      </div>
    </div>
  </div></div></section>

  <!-- ============ 08 · RETRO ============ -->
  <section class="panel"><div class="wrap"><div class="panel-card" data-panel>
    <div class="panel-head">
      <span class="panel-num">08</span>
      <h2 class="panel-title"><span class="cs">Pluginy umřely. Sledování ne.</span><span class="en">Plugins died. Tracking didn't.</span></h2>
      <span class="panel-sub"><span class="cs">jen se přestěhovalo</span><span class="en">it just moved</span></span>
    </div>
    <div style="padding: 22px 24px;">
      <p class="lead">
        <span class="cs">Kdysi měly weby přes pluginy přístup hluboko do systému. Ty jsou pryč —
        <b>sledování ale jen změnilo adresu</b>. Všechno, co jsi viděl nahoře, je jejich náhrada:</span>
        <span class="en">Plugins once gave sites deep access into your system. They're gone —
        <b>tracking just changed address</b>. Everything you saw above is what replaced them:</span>
      </p>
      <div class="retro-grid">
        <div class="retro"><div class="rn">Flash</div><div class="rs">† 2020</div><div class="rd"><span class="cs">„Super-cookies", které přežily smazání cookies.</span><span class="en">"Super-cookies" that survived a cookie wipe.</span></div><div class="rnow"><span class="cs">→ dnes: ETag v cache (panel 04)</span><span class="en">→ today: ETag in cache (panel 04)</span></div></div>
        <div class="retro"><div class="rn">ActiveX</div><div class="rs">† 2022</div><div class="rd"><span class="cs">Hardware a systém přímo z Windows.</span><span class="en">Hardware and system info straight from Windows.</span></div><div class="rnow"><span class="cs">→ dnes: GPU přes WebGL, client hints</span><span class="en">→ today: GPU via WebGL, client hints</span></div></div>
        <div class="retro"><div class="rn">Java applety</div><div class="rs">† 2017</div><div class="rd"><span class="cs">Seznam fontů a přesné info o stroji.</span><span class="en">Font lists and exact machine details.</span></div><div class="rnow"><span class="cs">→ dnes: detekce fontů, canvas otisk</span><span class="en">→ today: font probing, canvas fingerprint</span></div></div>
        <div class="retro"><div class="rn">Silverlight</div><div class="rs">† 2021</div><div class="rd"><span class="cs">Vlastní runtime s vlastním úložištěm.</span><span class="en">Its own runtime with its own storage.</span></div><div class="rnow"><span class="cs">→ dnes: audio otisk, WebRTC</span><span class="en">→ today: audio fingerprint, WebRTC</span></div></div>
      </div>
    </div>
  </div></div></section>

  <!-- ============ FINÁLE · SPIS ============ -->
  <section class="outro">
    <span class="section-label"><span class="cs">tvůj spis</span><span class="en">your file</span></span>
    <h2>
      <span class="cs">Tohle všechno. Bez jediného kliknutí.</span>
      <span class="en">All of this. Without a single click.</span>
    </h2>

    <div class="dossier" data-panel>
      <div class="dossier-head">
        <span class="ds-rec">● REC</span>
        <span class="ds-title"><span class="cs">SLOŽKA SUBJEKTU</span><span class="en">SUBJECT FILE</span></span>
        <span class="ds-code" id="ds-code">#········</span>
      </div>
      <p class="ds-story" id="ds-story">…</p>
      <div class="dossier-grid">
        <div class="ds-row"><span class="ds-k"><span class="cs">Poloha</span><span class="en">Location</span></span><span class="ds-v" id="ds-loc">…</span></div>
        <div class="ds-row"><span class="ds-k"><span class="cs">IP</span><span class="en">IP</span></span><span class="ds-v" id="ds-ip">…</span></div>
        <div class="ds-row"><span class="ds-k"><span class="cs">Zařízení</span><span class="en">Device</span></span><span class="ds-v" id="ds-device">…</span></div>
        <div class="ds-row"><span class="ds-k"><span class="cs">Prohlížeč</span><span class="en">Browser</span></span><span class="ds-v" id="ds-browser">…</span></div>
        <div class="ds-row"><span class="ds-k"><span class="cs">Otisk</span><span class="en">Fingerprint</span></span><span class="ds-v" id="ds-fp">…</span></div>
        <div class="ds-row"><span class="ds-k"><span class="cs">Uložené sledování</span><span class="en">Persistent tag</span></span><span class="ds-v" id="ds-super">…</span></div>
      </div>
      <div class="ds-track">
        <div class="ds-track-label"><span class="cs">SLEDOVATELNOST</span><span class="en">TRACKABILITY</span></div>
        <div class="ds-track-val" id="ds-track">…</div>
        <div class="ds-track-note" id="ds-track-note"></div>
      </div>
    </div>

    <p>
      <span class="cs">Každý web, na který přijdeš, vidí přesně tohle — a obvykle to spojí
      s tvým otiskem napříč návštěvami. Není to chyba. Tak je web postavený.</span>
      <span class="en">Every site you visit sees exactly this — and usually ties it to your
      fingerprint across visits. It's not a bug. It's how the web is built.</span>
    </p>
    <div class="defend" data-panel>
      <span class="section-label"><span class="cs">co s tím?</span><span class="en">what can you do?</span></span>
      <div class="defend-grid">
        <div class="tip"><div class="tt"><span class="cs">VPN skryje IP. Ne tebe.</span><span class="en">A VPN hides your IP. Not you.</span></div>
          <div class="td"><span class="cs">Změní jen řádek „IP" a „Město". Otisk, jazyk, hodiny i klávesnice zůstanou.</span><span class="en">It only changes the "IP" and "City" rows. Fingerprint, language, clock and keyboard stay.</span></div></div>
        <div class="tip"><div class="tt"><span class="cs">Prohlížeč, který se brání</span><span class="en">A browser that fights back</span></div>
          <div class="td"><span class="cs">Firefox (režim Přísný), Brave (náhodný otisk) nebo Safari. Chrome se nebrání skoro vůbec.</span><span class="en">Firefox (Strict mode), Brave (randomised fingerprint) or Safari. Chrome barely fights back.</span></div></div>
        <div class="tip"><div class="tt"><span class="cs">Blokuj trackery</span><span class="en">Block trackers</span></div>
          <div class="td"><span class="cs">uBlock Origin zastaví většinu reklamních a měřicích skriptů dřív, než si tě spočítají.</span><span class="en">uBlock Origin stops most ad and analytics scripts before they can profile you.</span></div></div>
        <div class="tip"><div class="tt"><span class="cs">Anonymní okno ≠ anonymita</span><span class="en">Incognito ≠ anonymous</span></div>
          <div class="td"><span class="cs">Jen po sobě smaže historii u tebe. Webům se neschováš.</span><span class="en">It only wipes your local history. Sites still see you.</span></div></div>
        <div class="tip"><div class="tt"><span class="cs">Svolení dávej střídmě</span><span class="en">Grant permissions sparingly</span></div>
          <div class="td"><span class="cs">Poloha, kamera, mikrofon: povolené jednou, platí často napořád. Projdi si je v nastavení.</span><span class="en">Location, camera, mic: granted once, often kept forever. Review them in settings.</span></div></div>
        <div class="tip"><div class="tt"><span class="cs">Chceš opravdu zmizet?</span><span class="en">Really want to vanish?</span></div>
          <div class="td"><span class="cs">Tor Browser: všichni uživatelé vypadají stejně. Pomalejší, ale otisk nemáš.</span><span class="en">Tor Browser: every user looks the same. Slower, but no fingerprint.</span></div></div>
      </div>
    </div>
    <div class="share">
      <button id="share-btn" type="button">
        <span class="cs">📤 Pošli to někomu, kdo si myslí, že je na webu anonymní</span>
        <span class="en">📤 Send this to someone who thinks they're anonymous online</span>
