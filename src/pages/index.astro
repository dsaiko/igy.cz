  // --- VPN / proxy: IP patří VPN/datacentru? A jdou hodiny prohlížeče jinak než IP? ---
  var VPN_RE = /(nord|proton|mullvad|express ?vpn|surfshark|cyberghost|private internet access|windscribe|ipvanish|hide\.me|purevpn|m247|datacamp|cdn77|leaseweb|ovh|hetzner|digitalocean|amazon|google cloud|microsoft|azure|linode|akamai|vultr|choopa|contabo|scaleway|oracle|alibaba|tencent|zscaler|cloudflare|fastly|clouvider|packethub)/i;
  function tzOffsetName(tz){
    try {
      var parts = new Intl.DateTimeFormat('en-US', { timeZone: tz, timeZoneName: 'longOffset' }).formatToParts(new Date());
      for (var i = 0; i < parts.length; i++) if (parts[i].type === 'timeZoneName') return parts[i].value;
    } catch(e){}
