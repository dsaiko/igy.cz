  setTimeout(function(){ revealHero(null); }, 2600);

  // ===================== 02 · ZAŘÍZENÍ =====================
  // Kolektory jsou idempotentní: spouští je jak vlastní panel, tak spis
  // (collectDossier) — podle toho, co uživatel uvidí dřív.
  function collectDevice(){
    if (S.device) return;
    S.device = true;
    renderDevice();
    collectMediaDevices();
  }
  function renderDevice(){
    var n = navigator, s = screen;
    // navigator.platform je "zmražený" — na Apple Silicon vrací "MacIntel".
    // Zpřesníme: Chromium přes high-entropy client hints, Safari odhadem z GPU.
    var plat = (n.userAgentData && n.userAgentData.platform) || n.platform || null;
    set('platform', plat);
    if (n.userAgentData && n.userAgentData.getHighEntropyValues){
      n.userAgentData.getHighEntropyValues(['architecture','bitness']).then(function(h){
        if (h && h.architecture){
          set('platform', plat + '  ·  ' + h.architecture + (h.bitness ? '/' + h.bitness : ''), 'hot');
        }
      }).catch(function(){});
    } else {
      var gpu = getGPU() || '';
      if (/Apple M\d/.test(gpu) && /MacIntel/i.test(plat || '')){
        set('platform', plat + tr('  ·  ve skutečnosti Apple Silicon', '  ·  actually Apple Silicon'), 'hot');
      }
    }
    set('cores', n.hardwareConcurrency ? (n.hardwareConcurrency + tr(' jader', ' cores')) : null, 'hot');
    set('ram', n.deviceMemory ? ('≥ ' + n.deviceMemory + ' GB') : tr('skryto', 'hidden'), n.deviceMemory ? 'hot' : '');
    set('touch', (n.maxTouchPoints || 0) + (n.maxTouchPoints > 0 ? tr('  · dotykové', '  · touch') : tr('  · myš', '  · mouse')));
    set('screen', s.width + ' × ' + s.height, 'hot');
    var bat = S.battery;
    set('battery', batteryText(), (bat && bat.level != null && !bat.plugged) ? 'danger' : '');
    // screen.isExtended: Chromium, bez svolení (detaily monitorů by svolení chtěly)
    if (typeof s.isExtended === 'boolean') set('monitors', s.isExtended ? tr('víc než jeden', 'more than one') : tr('jeden', 'one'), s.isExtended ? 'hot' : '');
    else set('monitors', tr('skryto (jen Chrome/Edge)', 'hidden (Chrome/Edge only)'));
    set('viewport', window.innerWidth + ' × ' + window.innerHeight);
    set('dpr', (window.devicePixelRatio || 1) + '×');
    set('depth', s.colorDepth + '-bit');
    set('os', guessOS());
    var gpu = getGPU();
    set('gpu', gpu || tr('skryto', 'hidden'), gpu ? 'hot' : '');
    var g = guessDevice();
    set('device-guess', g ? (g.name + '  ·  ' + g.price) : tr('nelze odhadnout', 'cannot guess'), g ? 'hot' : '');
    renderMedia();
  }
  // Hrubý (schválně drzý) odhad zařízení a jeho ceny z GPU a UA.
  function guessDevice(){
    var gpu = getGPU() || '', ua = navigator.userAgent;
    // iPad s desktopovým UA dřív, než ho GPU (Apple M…) prohlásí za Mac.
    if (isIPadDesktopUA()) return { name: 'iPad', price: tr('~12–30 tis. Kč', '~$600–1300') };
    var m = gpu.match(/Apple (M\d[A-Za-z ]*)/);
    if (m) return { name: 'MacBook / Mac (' + m[1].trim() + ')', price: tr('~40–90 tis. Kč', '~$2000–4000') };
    if (/\b(iPhone)\b/.test(ua)) return { name: 'iPhone', price: tr('~15–35 tis. Kč', '~$700–1500') };
    if (/\b(iPad)\b/.test(ua)) return { name: 'iPad', price: tr('~12–30 tis. Kč', '~$600–1300') };
    if (/Android/.test(ua)) return { name: tr('Android telefon/tablet', 'Android phone/tablet'), price: tr('~5–30 tis. Kč', '~$200–1300') };
    var rtx = gpu.match(/(RTX|GTX)\s?\d{3,4}\s?(Ti|Super)?/i);
    if (rtx) return { name: tr('herní PC (NVIDIA ', 'gaming PC (NVIDIA ') + rtx[0].trim() + ')', price: tr('~25–60 tis. Kč', '~$1200–3000') };
    var rad = gpu.match(/Radeon[^,)]*/i);
    if (rad) return { name: 'PC (' + rad[0].trim() + ')', price: tr('~15–45 tis. Kč', '~$700–2200') };
    if (/Intel/i.test(gpu)) return { name: tr('kancelářský/laptop (Intel grafika)', 'office/laptop (Intel graphics)'), price: tr('~10–25 tis. Kč', '~$500–1200') };
    return null;
  }

  // Počet a typ A/V zařízení — dostupné i BEZ svolení (labely jsou prázdné,
  // ale počet a kind ne). Lidi čekají, že tohle jde až po povolení.
  function collectMediaDevices(){
    if (S.media) { renderMedia(); return; }
    if (!navigator.mediaDevices || !navigator.mediaDevices.enumerateDevices){ S.media = { unsupported: true }; renderMedia(); return; }
    navigator.mediaDevices.enumerateDevices().then(function(list){
      var cams = 0, mics = 0;
      list.forEach(function(d){ if (d.kind === 'videoinput') cams++; else if (d.kind === 'audioinput') mics++; });
      S.media = { cams: cams, mics: mics };
      renderMedia();
      if (S.dossierReady) renderDossier();
    }).catch(function(){ S.media = { error: true }; renderMedia(); });
  }
  function renderMedia(){
    var m = S.media;
    if (!m){ set('media-cam', tr('zjišťuji…','checking…')); set('media-mic', tr('zjišťuji…','checking…')); return; }
    if (m.unsupported || m.error){ set('media-cam', '—'); set('media-mic', '—'); return; }
    set('media-cam', m.cams + tr(m.cams===1?' kamera':' kamer', m.cams===1?' camera':' cameras'), m.cams ? 'danger' : '');
    set('media-mic', m.mics + tr(m.mics===1?' mikrofon':' mikrofonů', m.mics===1?' mic':' mics'), m.mics ? 'danger' : '');
  }
  // iPadOS Safari se defaultně hlásí jako desktopový Mac ("Macintosh"),
  // prozradí ho až dotyk.
  function isIPadDesktopUA(){ return /Macintosh/.test(navigator.userAgent) && navigator.maxTouchPoints > 1; }
  function guessOS(){
    var u = navigator.userAgent;
    // iOS UA obsahuje "like Mac OS X" → musí jít před testem na macOS.
    if (/(iPhone|iPad|iPod)/.test(u)) return 'iOS / iPadOS';
    if (isIPadDesktopUA()) return 'iPadOS';
    if (/Windows NT 10/.test(u)) return 'Windows 10/11';
    if (/Mac OS X/.test(u)) return 'macOS';
    if (/Android/.test(u)) return 'Android';
    if (/Linux/.test(u)) return 'Linux';
    return tr('neznámý', 'unknown');
  }

  // ===================== 03 · PROHLÍŽEČ =====================
  function collectBrowser(){ S.browser = true; renderBrowser(); }
  function renderBrowser(){
    var n = navigator;
    set('browser', guessBrowser());
    var inc = S.incognito;
    if (inc === undefined) set('incognito', tr('zjišťuji…', 'checking…'));
    else if (inc === true) set('incognito', tr('vypadá to, že ANO — a stejně tě poznávám', 'looks like YES — and I still recognise you'), 'danger');
    else if (inc === false) set('incognito', tr('nejspíš běžné okno', 'probably a regular window'));
    else if (inc === 'chromium') set('incognito', tr('nepoznám — Chrome to dnes schovává (a dobře dělá)', 'can\'t tell — Chrome now hides it (good for you)'));
    else set('incognito', tr('nepoznám', 'can\'t tell'));
    var prefs = [];
    prefs.push(mm('(prefers-color-scheme: dark)') ? tr('tmavý režim', 'dark mode') : tr('světlý režim', 'light mode'));
    if (mm('(prefers-reduced-motion: reduce)')) prefs.push(tr('omezené animace', 'reduced motion'));
    if (mm('(prefers-contrast: more)')) prefs.push(tr('vyšší kontrast', 'more contrast'));
    if (mm('(forced-colors: active)')) prefs.push(tr('vynucené barvy', 'forced colours'));
    if (mm('(prefers-reduced-transparency: reduce)')) prefs.push(tr('méně průhlednosti', 'less transparency'));
    set('prefs', prefs.join('  ·  '), 'hot');
    set('engine', guessEngine());
    set('langs', (n.languages && n.languages.join(', ')) || n.language || null, 'hot');
    var tz = (Intl.DateTimeFormat().resolvedOptions().timeZone) || null;
    set('tz', tz, 'hot');
    set('localtime', new Date().toLocaleString());
    try {
      set('locale', (1234567.89).toLocaleString() + '  ·  ' + new Intl.NumberFormat().resolvedOptions().locale);
    } catch(e){ set('locale', null); }
    var dnt = n.doNotTrack || window.doNotTrack || (n.msDoNotTrack);
    set('dnt', (dnt === '1' || dnt === 'yes') ? tr('zapnuto (web to může ignorovat)','on (sites may ignore it)') : tr('vypnuto', 'off'));
    set('cookies', n.cookieEnabled ? tr('povolené', 'enabled') : tr('zakázané', 'disabled'));
    set('ua', n.userAgent);
  }
  function guessBrowser(){
    var u = navigator.userAgent;
    if (navigator.brave) return 'Brave';
    // Na iOS mají prohlížeče vlastní tokeny (CriOS, FxiOS, EdgiOS…) a všechny
    // navíc "Safari/" → musí se chytit dřív než Safari.
    if (/Edg(A|iOS)?\//.test(u)) return 'Edge';
    if (/(OPR|OPT|OPiOS)\//.test(u)) return 'Opera';
    if (/(Firefox|FxiOS)\//.test(u)) return 'Firefox';
    if (/(Chrome|CriOS)\//.test(u)) return 'Chrome';
    if (/Safari\//.test(u)) return 'Safari';
    return tr('neznámý', 'unknown');
  }
  function guessEngine(){
    var u = navigator.userAgent;
    if (/Gecko\/|Firefox/.test(u) && !/like Gecko/.test(u)) return 'Gecko';
    if (/AppleWebKit/.test(u) && /Chrome/.test(u)) return 'Blink';
    if (/AppleWebKit/.test(u)) return 'WebKit';
    return '—';
  }

  // ===================== 04 · OTISK =====================
  // cyrb53 hash → krátký hex
  function cyrb53(str, seed){
    seed = seed || 0;
    var h1 = 0xdeadbeef ^ seed, h2 = 0x41c6ce57 ^ seed;
    for (var i = 0, ch; i < str.length; i++){
      ch = str.charCodeAt(i);
      h1 = Math.imul(h1 ^ ch, 2654435761);
      h2 = Math.imul(h2 ^ ch, 1597334677);
    }
    h1 = Math.imul(h1 ^ (h1>>>16), 2246822507) ^ Math.imul(h2 ^ (h2>>>13), 3266489909);
    h2 = Math.imul(h2 ^ (h2>>>16), 2246822507) ^ Math.imul(h1 ^ (h1>>>13), 3266489909);
    return (4294967296 * (2097151 & h2) + (h1>>>0)).toString(16);
  }
  function getGL(){
    try {
      var c = document.createElement('canvas');
      return c.getContext('webgl') || c.getContext('experimental-webgl');
    } catch(e){ return null; }
  }
  function getGPU(){
    var gl = getGL(); if (!gl) return null;
    try {
      var ext = gl.getExtension('WEBGL_debug_renderer_info');
      if (ext) return gl.getParameter(ext.UNMASKED_RENDERER_WEBGL);
      return gl.getParameter(gl.RENDERER);
    } catch(e){ return null; }
  }
  function canvasFP(){
    try {
      var c = document.createElement('canvas'); c.width = 280; c.height = 60;
      var ctx = c.getContext('2d');
      ctx.textBaseline = 'top'; ctx.font = '16px "Arial"';
      ctx.fillStyle = '#f60'; ctx.fillRect(0,0,140,30);
      ctx.fillStyle = '#069'; ctx.fillText('I Google You · igy.cz 🛰', 4, 8);
      ctx.fillStyle = 'rgba(56,232,200,0.7)'; ctx.fillText('I Google You · igy.cz 🛰', 6, 20);
      ctx.beginPath(); ctx.arc(220, 30, 18, 0, Math.PI*2); ctx.fillStyle='rgba(255,92,108,0.6)'; ctx.fill();
      return cyrb53(c.toDataURL());
    } catch(e){ return null; }
  }
  function webglFP(){
    var gl = getGL(); if (!gl) return null;
    try {
      var parts = [];
      var keys = ['VERSION','SHADING_LANGUAGE_VERSION','VENDOR','RENDERER','MAX_TEXTURE_SIZE','MAX_VIEWPORT_DIMS','MAX_RENDERBUFFER_SIZE'];
      keys.forEach(function(k){ try { parts.push(k + '=' + gl.getParameter(gl[k])); } catch(e){} });
      var ext = gl.getSupportedExtensions(); if (ext) parts.push(ext.join(','));
      return cyrb53(parts.join('|'));
    } catch(e){ return null; }
  }
  function audioFP(){
    return new Promise(function(resolve){
      try {
        var OAC = window.OfflineAudioContext || window.webkitOfflineAudioContext;
        if (!OAC){ resolve(null); return; }
        var ctx = new OAC(1, 5000, 44100);
        var osc = ctx.createOscillator(); osc.type = 'triangle'; osc.frequency.value = 10000;
        var comp = ctx.createDynamicsCompressor();
        osc.connect(comp); comp.connect(ctx.destination); osc.start(0);
        ctx.startRendering();
        ctx.oncomplete = function(e){
          var d = e.renderedBuffer.getChannelData(0); var sum = 0;
          for (var i = 4000; i < 5000; i++) sum += Math.abs(d[i]);
          // toFixed(2) spolkne drobný jitter (stabilnější mezi načteními),
          // rozdíly dané enginem/hardwarem jsou větší a zůstanou zachovány.
          resolve(cyrb53(sum.toFixed(2)));
          try { osc.disconnect(); comp.disconnect(); } catch(_){}
        };
        setTimeout(function(){ resolve(null); }, 3000);
      } catch(e){ resolve(null); }
    });
  }
  function fontFP(){
    var base = ['monospace','sans-serif','serif'];
    var test = ['Arial','Calibri','Cambria','Comic Sans MS','Courier New','Georgia',
      'Helvetica Neue','Impact','Tahoma','Times New Roman','Trebuchet MS','Verdana',
      'Segoe UI','Roboto','Menlo','Monaco','Consolas','Ubuntu','Cantarell','DejaVu Sans'];
    var s = document.createElement('span');
    s.style.cssText = 'position:absolute;left:-9999px;font-size:72px;';
    s.textContent = 'mmmmmmmmmmlli';
    document.body.appendChild(s);
    function dims(font){ s.style.fontFamily = font; return s.offsetWidth + 'x' + s.offsetHeight; }
    var baseDims = {}; base.forEach(function(b){ baseDims[b] = dims(b); });
    var found = [];
    test.forEach(function(f){
      for (var i = 0; i < base.length; i++){
        if (dims("'" + f + "'," + base[i]) !== baseDims[base[i]]){ found.push(f); break; }
      }
    });
    document.body.removeChild(s);
    return found;
  }

  // ETag "supercookie" — bezstavový tracking přes cache (functions/api/etag.js).
  var scStarted = false;
  function collectSupercookie(){
    // Jen jednou za načtení: druhý dotaz by revalidoval čerstvě uložený ETag.
    if (scStarted) return; scStarted = true;
    // default cache mode → prohlížeč při revalidaci sám pošle If-None-Match
    fetch('/api/etag').then(function(r){ return r.ok ? r.json() : Promise.reject(); })
      .then(function(d){ S.sc = d; renderSupercookie(); onLate(); })
      .catch(function(){ S.sc = { error: true }; renderSupercookie(); if (S.dossierReady) renderDossier(); });
  }
  function renderSupercookie(){
    var idEl = document.getElementById('sc-id'), note = document.getElementById('sc-note');
    if (!idEl || !note || !S.sc) return;
    var d = S.sc;
    if (d.error){
      idEl.textContent = '—'; idEl.classList.remove('danger');
      note.textContent = tr('(jen na nasazeném webu)', '(only on deployed site)');
      return;
    }
    idEl.textContent = d.id;
    idEl.classList.toggle('danger', !!d.returning);
    var n = d.visits | 0, last = d.lastVisit ? relTime(d.lastVisit) : null;
    note.innerHTML = (d.returning && n > 1)
      ? tr('Vítej zpět. Tohle je tvoje <b>' + n + '. návštěva</b>' + (last ? ', minule jsi tu byl ' + esc(last) : '') + '. Pamatuje si to tvoje <b>cache</b> — i když sis mezitím smazal cookies.',
           'Welcome back. This is your <b>visit #' + n + '</b>' + (last ? ', last time was ' + esc(last) : '') + '. Your <b>cache</b> remembers — even if you cleared cookies since.')
      : d.returning
      ? tr('Poznávám tě — tohle ID ti sedí v <b>cache</b>. Vrátil ses, i kdybys mezitím smazal cookies.',
           'I recognize you — this ID lives in your <b>cache</b>. You came back, even if you cleared cookies.')
      : tr('Právě jsem ti ho přiřadil a uložil do cache. <b>Smaž si cookies a přijď jindy</b> — pozdravím tě stejným ID a spočítám tvoje návštěvy.',
           'I just assigned it and cached it. <b>Clear your cookies now and come back later</b> — I\'ll greet you with the same ID and count your visits.');
  }

  function collectFingerprint(){
    // Druhý běh by znovu zavolal /api/etag — ten už by revalidoval čerstvě
    // uložený ETag a prvonávštěvníkovi tvrdil "poznávám tě".
    if (S.fp) return;
    collectSupercookie();
    var bar = document.getElementById('fp-progress');
    var steps = 0, totalSteps = 4;
    function bump(){ steps++; if (bar) bar.style.width = Math.round(steps/totalSteps*100) + '%'; }

    var cv = canvasFP(); var wg = webglFP(); var fonts = fontFP();
    S.fp = { cv: cv, wg: wg, fonts: fonts, au: null, audioDone: false, id: null };
    renderFpRows(); bump(); bump(); bump();

    audioFP().then(function(au){
      S.fp.au = au; S.fp.audioDone = true;
      renderFpRows(); bump();
      // složený otisk (jazykově nezávislý)
      var combined = [cv, wg, au, fonts.join(','), getGPU(),
        navigator.userAgent, navigator.language,
        Intl.DateTimeFormat().resolvedOptions().timeZone,
        Math.max(screen.width, screen.height) + 'x' + Math.min(screen.width, screen.height) + 'x' + screen.colorDepth,
        (navigator.hardwareConcurrency||'') + '/' + (navigator.deviceMemory||'')
      ].join('::');
      S.fp.id = cyrb53(combined, 1).toUpperCase().padStart(11,'0');
      animateFpId(S.fp.id);
      if (S.dossierReady) renderDossier();
    });
  }
  function renderFpRows(){
    if (!S.fp) return;
    set('fp-canvas', S.fp.cv || tr('blokováno', 'blocked'), S.fp.cv ? 'hot':'');
    set('fp-webgl', S.fp.wg || tr('blokováno', 'blocked'), S.fp.wg ? 'hot':'');
    if (S.fp.audioDone) set('fp-audio', S.fp.au || tr('blokováno', 'blocked'), S.fp.au ? 'hot':'');
    var f = S.fp.fonts || [];
    set('fp-fonts', f.length + tr(' z 20  ·  ', ' of 20  ·  ') + f.slice(0,6).join(', ') + (f.length>6?'…':''), 'hot');
    var sw = softwareFromFonts(f);
    set('fp-software', sw.length ? sw.join(', ') : tr('nic jednoznačného', 'nothing conclusive'), sw.length ? 'danger' : '');
  }
  // Odvození nainstalovaného softwaru/OS z detekovaných fontů (best-effort).
  function softwareFromFonts(fonts){
    var has = {}; (fonts||[]).forEach(function(f){ has[f] = 1; });
    var out = [];
    if (has['Calibri'] || has['Cambria']) out.push('MS Office');
    if (has['Segoe UI']) out.push('Windows');
    if (has['Helvetica Neue'] || has['Menlo'] || has['Monaco']) out.push('macOS');
    if (has['Ubuntu'] || has['Cantarell'] || has['DejaVu Sans']) out.push('Linux');
    // dedup při zachování pořadí
    return out.filter(function(v, i){ return out.indexOf(v) === i; });
  }
  function animateFpId(fid){
    var idEl = document.getElementById('fp-id'); if (!idEl) return;
    if (reduced()){ idEl.textContent = fid; return; }
    var target = fid.split(''), glyphs = '0123456789ABCDEF', frame = 0;
    var iv = setInterval(function(){
      frame++;
      idEl.textContent = target.map(function(ch, i){
        return (frame > i*2+4) ? ch : glyphs[(frame + i) % 16];
      }).join('');
      if (frame > target.length*2 + 6){ clearInterval(iv); idEl.textContent = fid; }
    }, 45);
  }

  // ===================== 05 · PŮVOD (triangulace) =====================
  // Spolehlivý "bait": element s reklamními třídami. Pokud ho adblock schová
  // (výška 0 / display none), je aktivní. Plně lokální, nic neodchází.
  function detectAdblock(cb){
    var bait = document.createElement('div');
    bait.className = 'ad ads adsbox ad-banner ad-placement pub_300x250 textads banner_ad sponsored';
    bait.style.cssText = 'position:absolute!important;left:-9999px;top:-9999px;width:300px;height:250px;';
    bait.innerHTML = '&nbsp;';
    document.body.appendChild(bait);
    setTimeout(function(){
      var blocked = !bait.offsetHeight || !bait.offsetParent ||
        bait.clientHeight === 0 || getComputedStyle(bait).display === 'none' ||
        getComputedStyle(bait).visibility === 'hidden';
      try { document.body.removeChild(bait); } catch(_){}
      cb(blocked);
    }, 130);
  }

  // Best-effort detekce regionálního filtru přes cosmetic baiting. Selektory
  // se mění → je to orientační (a po nasazení doladíme reálné baity).
  // Mapuje "kosmetické pravidlo, které řeší hlavně daný regionální seznam" → země.
  var REGION_BAITS = [
    { country: 'CZ', sel: 'div', cls: 'reklama reklamni-banner inzerce' },
    { country: 'PL', sel: 'div', cls: 'reklama-box rekl' },
  ];
  function detectRegionFilter(cb){
    var nodes = REGION_BAITS.map(function(b){
      var el = document.createElement(b.sel);
      el.className = b.cls;
      el.style.cssText = 'position:absolute!important;left:-9999px;top:-9999px;width:280px;height:90px;';
      el.innerHTML = '&nbsp;';
      document.body.appendChild(el);
      return el;
    });
    setTimeout(function(){
      var hit = null;
      for (var i = 0; i < nodes.length; i++){
        var el = nodes[i];
        var blocked = !el.offsetHeight || !el.offsetParent || getComputedStyle(el).display === 'none';
        if (blocked && !hit) hit = REGION_BAITS[i].country;
      }
      nodes.forEach(function(n){ try { document.body.removeChild(n); } catch(_){} });
      cb(hit);
    }, 150);
  }

  var FLAG = { CZ:'🇨🇿', SK:'🇸🇰', PL:'🇵🇱', DE:'🇩🇪', AT:'🇦🇹', US:'🇺🇸', GB:'🇬🇧', FR:'🇫🇷', ES:'🇪🇸', IT:'🇮🇹', PT:'🇵🇹' };
  var CNAME = { CZ:{cs:'Česko',en:'Czechia'}, SK:{cs:'Slovensko',en:'Slovakia'},
    PL:{cs:'Polsko',en:'Poland'}, DE:{cs:'Německo',en:'Germany'}, AT:{cs:'Rakousko',en:'Austria'},
    US:{cs:'USA',en:'USA'}, GB:{cs:'Velká Británie',en:'United Kingdom'},
    FR:{cs:'Francie',en:'France'}, ES:{cs:'Španělsko',en:'Spain'}, IT:{cs:'Itálie',en:'Italy'}, PT:{cs:'Portugalsko',en:'Portugal'} };
  function flag(cc){ return cc ? (FLAG[cc] || '🏳️') + ' ' + cc : ''; }

  function tzCountry(tz){
    if (!tz) return null;
    var map = { 'Europe/Prague':'CZ','Europe/Bratislava':'SK','Europe/Warsaw':'PL',
      'Europe/Berlin':'DE','Europe/Vienna':'AT','Europe/London':'GB',
      'America/New_York':'US','America/Los_Angeles':'US','America/Chicago':'US' };
    return map[tz] || null;
  }
  function langCountry(l){
    if (!l) return null;
    // Region jen z opravdového region subtagu — ne ze skriptu (zh-Hans-CN,
    // sr-Latn-RS) ani z číselného regionu (es-419).
    var region = null;
    try { region = new Intl.Locale(l).region || null; }
    catch(e){ region = (l.split(/[-_]/).slice(1).filter(function(p){ return /^[a-z]{2}$/i.test(p); })[0]) || null; }
    if (region) return /^[A-Z]{2}$/i.test(region) ? region.toUpperCase() : null;
    var map = { cs:'CZ', sk:'SK', pl:'PL', de:'DE', en:null };
    return map[l.toLowerCase().split(/[-_]/)[0]] || null;
  }

  var adblockOn = null, adblockRegion = null;
  function renderOrigin(){
    var votes = {};
    function vote(cc, n){ if (cc) votes[cc] = (votes[cc]||0) + (n||1); }

    // 1) IP — nezávislý a silný signál (váha 2)
    var ipCC = (S.whoami && S.whoami.geo && S.whoami.geo.country) || null;
    if (ipCC){ set('o-ip', flag(ipCC), 'hot'); vote(ipCC, 2); }
    else set('o-ip', tr('(jen na nasazeném webu)','(only on deployed site)'));

    // 2) timezone (nezávislý)
    var tz = null; try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone; } catch(e){}
    var tzCC = tzCountry(tz);
    set('o-tz', tz ? (tz + (tzCC ? '  → ' + flag(tzCC) : '')) : '—', tzCC ? 'hot':''); vote(tzCC);

    // 3) jazyk (nezávislý)
    var lang = (navigator.languages && navigator.languages[0]) || navigator.language || null;
    var langCC = langCountry(lang);
    set('o-lang', lang ? (lang + (langCC ? '  → ' + flag(langCC) : '')) : '—', langCC ? 'hot':''); vote(langCC);

    // 3b) klávesnice (nezávislá na jazyku prohlížeče → silný hlas, váha 2)
    var k = S.kbd;
    if (!k) set('o-kbd', tr('zjišťuji…', 'checking…'));
    else if (k.unsupported) set('o-kbd', tr('skryto (jen Chrome/Edge)', 'hidden (Chrome/Edge only)'));
    else if (k.cc){ set('o-kbd', k.layout + '  → ' + flag(k.cc), 'danger'); vote(k.cc, 2); }
    else set('o-kbd', k.layout + tr('  (bez národních znaků)', '  (no national keys)'));

    // 4) locale / formát čísel — odvozeno z jazyka (jen zobrazení, NEHLASUJE,
    //    aby se stejný signál nepočítal dvakrát).
    try {
      var loc = new Intl.NumberFormat().resolvedOptions().locale;
      var locCC = langCountry(loc);
      set('o-locale', (1234567.89).toLocaleString() + '  ·  ' + loc + (locCC ? '  → ' + flag(locCC) : ''), locCC ? 'hot':'');
    } catch(e){ set('o-locale', '—'); }

    // 5) adblock + regionální filtr (doplní se asynchronně)
    if (adblockOn === null) set('o-adblock', tr('zjišťuji…','checking…'));
    else set('o-adblock', adblockOn ? tr('ANO — máš blokovač','YES — blocker on') : tr('ne','no'), adblockOn ? 'hot':'');
    if (adblockRegion){ set('o-adregion', flag(adblockRegion) + tr('  (podle filtru)','  (by filter)'), 'danger'); vote(adblockRegion, 2); }
    else if (adblockOn === false || adblockRegion === false) set('o-adregion', tr('—','—'));
    else set('o-adregion', tr('zjišťuji…','checking…'));

    // verdikt — země s nejvíc hlasy
    var best = null, bestN = 0, total = 0;
    Object.keys(votes).forEach(function(cc){ total += votes[cc]; if (votes[cc] > bestN){ bestN = votes[cc]; best = cc; } });
    S.originBest = best;
    if (S.dossierReady) renderDossier();
    var vEl = document.getElementById('origin-verdict');
    var nEl = document.getElementById('origin-note');
    if (best){
      var nm = CNAME[best] ? CNAME[best][T()] : best;
      vEl.textContent = (FLAG[best]||'🏳️') + '  ' + nm;
      nEl.innerHTML = tr(
        'Souhlasí <b style="color:var(--accent)">' + bestN + '</b> z ' + total + ' hlasů. Odhaduju, že jsi z téhle země — i kdyby IP tvrdila něco jiného.',
        '<b style="color:var(--accent)">' + bestN + '</b> of ' + total + ' votes agree. My guess where you\'re from — even if your IP says otherwise.'
      );
    } else {
      vEl.textContent = '· · ·';
    }
  }

  function collectOrigin(){
    if (S.originReady) return;
    S.originReady = true;
    renderOrigin();
    detectAdblock(function(on){
      adblockOn = on;
      renderOrigin();
      if (on){
        // false = dozjišťováno bez shody (null znamená "ještě běží")
        detectRegionFilter(function(cc){ adblockRegion = cc || false; renderOrigin(); });
      } else {
        adblockRegion = false; renderOrigin();
      }
    });
  }

  // ===================== 06 · SVOLENÍ =====================
  function bindPerms(){
    var geo = document.getElementById('perm-geo');
    geo && geo.addEventListener('click', function(){
      var pr = document.getElementById('pr-geo');
      pr.textContent = tr('ptám se…', 'asking…');
      if (!navigator.geolocation){ pr.textContent = tr('nedostupné','unavailable'); return; }
      navigator.geolocation.getCurrentPosition(function(p){
        pr.classList.add('danger');
        var la = p.coords.latitude, lo = p.coords.longitude, acc = Math.round(p.coords.accuracy);
        pr.textContent = la.toFixed(5) + ', ' + lo.toFixed(5) + '  ±' + acc + 'm';
        S.precise = { lat: la, lon: lo, acc: acc, address: null };
        var box = document.getElementById('geo-precise');
        var f = document.getElementById('geo-precise-map');
        var lnk = document.getElementById('geo-precise-link');
        var addr = document.getElementById('geo-precise-addr');
        if (f) f.src = osmEmbed(la, lo, 0.004);   // uličková úroveň
        if (lnk) lnk.href = osmLink(la, lo, 17);
        if (addr) addr.textContent = tr('zjišťuji adresu…', 'looking up address…');
        if (box) box.hidden = false;
        if (S.dossierReady) renderDossier();   // spis hned na GPS (bez čekání na adresu)
        reverseGeocode(la, lo, S.precise);      // …a doplň celou adresu, až dorazí
      }, function(){ pr.textContent = tr('odmítnuto','denied'); }, { enableHighAccuracy: true, timeout: 10000 });
    });

    // Kamera: 3 s živého náhledu ("tohle vidím já"), pak zmrazený snímek.
    // Snímek zůstane jen na tvém plátně — nikam se neodesílá.
    var cam = document.getElementById('perm-cam');
    cam && cam.addEventListener('click', function(){
      var pr = document.getElementById('pr-cam');
      pr.textContent = tr('ptám se…', 'asking…');
      if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia){ pr.textContent = tr('nedostupné','unavailable'); return; }
      cam.disabled = true;
      navigator.mediaDevices.getUserMedia({ video: true }).then(function(stream){
        var box = document.getElementById('cam-box'), video = document.getElementById('cam-video'),
            still = document.getElementById('cam-still'), count = document.getElementById('cam-count'),
            cap = document.getElementById('cam-cap'), tick = 0;
        var track = stream.getVideoTracks()[0];
        var st = (track && track.getSettings) ? track.getSettings() : {};
        pr.classList.add('danger');
        pr.textContent = ((track && track.label) || tr('kamera','camera')) + (st.width ? '  ' + st.width + '×' + st.height : '');
        var guard = streamGuard(stream, 3000, function(){
          clearInterval(tick);
          // zmrazit poslední snímek (pokud už video nějaký má)
          try {
            if (video.videoWidth){
              still.width = video.videoWidth; still.height = video.videoHeight;
              still.getContext('2d').drawImage(video, 0, 0);
              still.hidden = false; video.hidden = true;
              cap.textContent = tr('…a tenhle snímek by si web mohl nechat. (Náš zůstal jen v tvém prohlížeči.)',
                                   '…and a site could keep this frame. (Ours stayed in your browser.)');
            } else { box.hidden = true; }
          } catch(e){ box.hidden = true; }
          video.srcObject = null; count.textContent = '';
          cam.disabled = false;
        });
        if (guard.done()) return;
        still.hidden = true; video.hidden = false; box.hidden = false;
        cap.textContent = tr('Tohle vidím já.', 'This is what I see.');
        video.srcObject = stream;
        var p = video.play(); if (p && p.catch) p.catch(function(){});
        var left = 3; count.textContent = left + ' s';
        tick = setInterval(function(){ left--; if (left > 0) count.textContent = left + ' s'; }, 1000);
      }).catch(function(){ cam.disabled = false; pr.textContent = tr('odmítnuto','denied'); });
    });

    var mic = document.getElementById('perm-mic');
    mic && mic.addEventListener('click', function(){
      var pr = document.getElementById('pr-mic');
      pr.textContent = tr('ptám se…', 'asking…');
      if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia){ pr.textContent = tr('nedostupné','unavailable'); return; }
      mic.disabled = true;
      navigator.mediaDevices.getUserMedia({ audio: true }).then(function(stream){
        var ac = null, raf = 0;
        var guard = streamGuard(stream, 8000, function(){
          cancelAnimationFrame(raf);
          if (ac){ try { ac.close(); } catch(e){} }
          pr.textContent += tr('  (stop)','  (stop)');
          mic.disabled = false;
        });
        if (guard.done()) return;
        var an, buf;
        try {
          var AC = window.AudioContext || window.webkitAudioContext;
          ac = new AC(); var src = ac.createMediaStreamSource(stream);
          an = ac.createAnalyser(); an.fftSize = 256; src.connect(an);
          buf = new Uint8Array(an.frequencyBinCount);
        } catch(e){
          // i když se analýza nepovede, mikrofon MUSÍ zhasnout
          guard.stop(); pr.textContent = tr('nešlo spustit analýzu zvuku', 'couldn\'t start audio analysis');
          return;
        }
        pr.classList.add('danger');
        (function tick(){
          if (guard.done()) return;
          an.getByteFrequencyData(buf);
          var sum = 0; for (var i=0;i<buf.length;i++) sum += buf[i];
          var lvl = Math.round(sum / buf.length);
          var bars = '█'.repeat(Math.min(20, Math.round(lvl/4)));
          pr.textContent = tr('hladina ', 'level ') + lvl + '  ' + bars;
          raf = requestAnimationFrame(tick);
        })();
      }).catch(function(){ mic.disabled = false; pr.textContent = tr('odmítnuto','denied'); });
    });
  }

  // Hlídač živého streamu (kamera/mikrofon): vypne ho po `ms`, při skrytí
  // záložky i při odchodu ze stránky — nezávisle na requestAnimationFrame,
  // který se ve skryté záložce zastaví. Když je záložka skrytá už při startu,
  // vypne hned. onStop běží PŘED zastavením stop, ať jde ještě sejmout snímek.
  function streamGuard(stream, ms, onStop){
    var done = false, to = setTimeout(stop, ms);
    function onVis(){ if (document.hidden) stop(); }
    function stop(){
      if (done) return; done = true;
      clearTimeout(to);
      document.removeEventListener('visibilitychange', onVis);
      window.removeEventListener('pagehide', stop);
      try { if (onStop) onStop(); } catch(e){}
      stream.getTracks().forEach(function(t){ t.stop(); });
    }
    document.addEventListener('visibilitychange', onVis);
    window.addEventListener('pagehide', stop);
    if (document.hidden) stop();
    return { stop: stop, done: function(){ return done; } };
  }

  // ===================== 06 · CHOVÁNÍ (živě) =====================
  // Posluchače navěsíme hned při načtení, ať se počítá od začátku.
  var beh = { mouse:0, dist:0, clicks:0, keys:0, scroll:0, away:0, start:0, lastX:null, lastY:null,
              pts:[], taps:[], lastPt:0 };
  // body pro heatmapu: poloha v okně jako zlomek (0–1), ať nezáleží na velikosti
  var HEAT_MAX = 3000;
  function heatPoint(x, y){
    var now = Date.now(); if (now - beh.lastPt < 30) return; beh.lastPt = now;
    if (beh.pts.length >= HEAT_MAX) beh.pts.shift();
    beh.pts.push([x / Math.max(1, window.innerWidth), y / Math.max(1, window.innerHeight)]);
  }
  function heatTap(x, y){
    if (beh.taps.length >= 200) beh.taps.shift();
    beh.taps.push([x / Math.max(1, window.innerWidth), y / Math.max(1, window.innerHeight)]);
  }
  function toast(html){
    var t = document.getElementById('toast');
    if (!t){ t = document.createElement('div'); t.id = 'toast'; t.className = 'toast'; t.setAttribute('role', 'status'); document.body.appendChild(t); }
    t.innerHTML = html; t.classList.add('show');
    clearTimeout(t.__h); t.__h = setTimeout(function(){ t.classList.remove('show'); }, 4500);
  }
  function initBehavior(){
    S.behavior = beh; beh.start = Date.now();
    window.addEventListener('mousemove', function(e){
      beh.mouse++;
      if (beh.lastX != null){ var dx = e.clientX-beh.lastX, dy = e.clientY-beh.lastY; beh.dist += Math.sqrt(dx*dx+dy*dy); }
      beh.lastX = e.clientX; beh.lastY = e.clientY;
      heatPoint(e.clientX, e.clientY);
    }, { passive:true });
    window.addEventListener('touchmove', function(e){ var t = e.touches && e.touches[0]; if (t) heatPoint(t.clientX, t.clientY); }, { passive:true });
    window.addEventListener('click', function(e){ beh.clicks++; heatTap(e.clientX, e.clientY); }, { passive:true });
    // Co sis zkopíroval — web to vidí (jen text z téhle stránky, nic neodchází).
    document.addEventListener('copy', function(){
      var txt = ''; try { txt = String(window.getSelection() || '').trim(); } catch(e){}
      if (!txt) return;
      S.copied = txt.length > 80 ? txt.slice(0, 80) + '…' : txt;
      toast(tr('📋 Vidím, co sis zkopíroval: <b>„' + esc(S.copied) + '“</b> — tohle umí každý web.',
               '📋 I saw what you copied: <b>"' + esc(S.copied) + '"</b> — any site can do this.'));
      renderBehavior();
      if (S.dossierReady) renderDossier();
    });
    window.addEventListener('keydown', function(){ beh.keys++; }, { passive:true });
    window.addEventListener('scroll', function(){
      var h = document.documentElement.scrollHeight - window.innerHeight;
      var p = h > 0 ? Math.round(window.scrollY / h * 100) : 0; if (p > beh.scroll) beh.scroll = p;
    }, { passive:true });
    document.addEventListener('visibilitychange', function(){ if (document.hidden) beh.away++; });
  }
  function renderBehavior(){
    var b = S.behavior; if (!b) return;
    set('b-time', Math.round((Date.now()-b.start)/1000) + ' s', 'hot');
    set('b-mouse', b.mouse + tr(' pohybů', ' moves'), b.mouse ? 'hot' : '');
    set('b-dist', Math.round(b.dist) + ' px', b.dist ? 'hot' : '');
    set('b-clicks', String(b.clicks));
    set('b-keys', String(b.keys), b.keys ? 'hot' : '');
    set('b-scroll', b.scroll + tr(' % stránky', ' % of the page'));
    set('b-away', b.away + (b.away ? tr('  · vím o tom', '  · I noticed') : ''), b.away ? 'danger' : '');
    set('b-copy', S.copied ? '„' + S.copied + '“' : tr('zatím nic — zkus něco označit a zkopírovat', 'nothing yet — try selecting and copying something'), S.copied ? 'danger' : '');
    drawHeat();
  }
  function drawHeat(){
    var c = document.getElementById('heat'); if (!c || !behLoop) return;
    var ctx = c.getContext('2d'); if (!ctx) return;
    // plátno má poměr stran tvého okna (v rozumných mezích)
    var W = 760, H = Math.round(W * Math.min(1.2, Math.max(0.35, window.innerHeight / Math.max(1, window.innerWidth))));
    var dpr = Math.min(window.devicePixelRatio || 1, 2);
    if (c.width !== W * dpr || c.height !== H * dpr){ c.width = W * dpr; c.height = H * dpr; }
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.globalCompositeOperation = 'source-over';
    ctx.fillStyle = '#05070a'; ctx.fillRect(0, 0, W, H);
    ctx.strokeStyle = 'rgba(255,255,255,0.05)'; ctx.lineWidth = 1;
    for (var gx = 0; gx <= W; gx += 38){ ctx.beginPath(); ctx.moveTo(gx, 0); ctx.lineTo(gx, H); ctx.stroke(); }
    for (var gy = 0; gy <= H; gy += 38){ ctx.beginPath(); ctx.moveTo(0, gy); ctx.lineTo(W, gy); ctx.stroke(); }
    var pts = beh.pts;
    if (!pts.length){
      ctx.fillStyle = 'rgba(139,149,163,0.8)'; ctx.font = '13px ui-monospace, monospace'; ctx.textAlign = 'center';
      ctx.fillText(tr('pohni myší / prstem…', 'move your mouse / finger…'), W / 2, H / 2);
      return;
    }
    // stopa
    ctx.strokeStyle = 'rgba(56,232,200,0.35)'; ctx.lineWidth = 1.2; ctx.beginPath();
    for (var i = 0; i < pts.length; i++){ var x = pts[i][0] * W, y = pts[i][1] * H; if (i) ctx.lineTo(x, y); else ctx.moveTo(x, y); }
    ctx.stroke();
    // teplo: kde se kurzor zdržel, se body sčítají
    ctx.globalCompositeOperation = 'lighter';
    for (var j = 0; j < pts.length; j++){
      var px = pts[j][0] * W, py = pts[j][1] * H;
      var g = ctx.createRadialGradient(px, py, 0, px, py, 16);
      g.addColorStop(0, 'rgba(255,92,108,0.10)'); g.addColorStop(1, 'rgba(255,92,108,0)');
      ctx.fillStyle = g; ctx.fillRect(px - 16, py - 16, 32, 32);
    }
    ctx.globalCompositeOperation = 'source-over';
    beh.taps.forEach(function(t){
      ctx.beginPath(); ctx.arc(t[0] * W, t[1] * H, 6, 0, Math.PI * 2);
      ctx.strokeStyle = 'rgba(255,184,77,0.95)'; ctx.lineWidth = 2; ctx.stroke();
    });
  }
  var behLoop = false;
  function collectBehavior(){
    if (behLoop) return; behLoop = true;
    renderBehavior();
    setInterval(renderBehavior, 500);
  }

  // ===================== FINÁLE · SPIS (dossier) =====================
  function setText(id, txt){ var el = document.getElementById(id); if (el) el.textContent = txt; }
  // Hrubý odhad entropie otisku → "jsi 1 z X".
  function trackBits(){
    var b = 10 + 4 + 4 + 3; // UA, obrazovka, timezone, jazyk (základ)
    if (S.fp){ if (S.fp.cv) b += 16; if (S.fp.wg) b += 10; if (S.fp.au) b += 6; b += Math.min((S.fp.fonts||[]).length, 20) * 0.6; }
    if (getGPU()) b += 5;
    if (navigator.hardwareConcurrency) b += 2;
    if (navigator.deviceMemory) b += 2;
    if (S.kbd && S.kbd.layout) b += S.kbd.cc ? 3 : 1;
    if (typeof screen.isExtended === 'boolean') b += 1;
    return Math.round(b);
  }
  var KBD_ADJ = { CZ:['české','Czech'], SK:['slovenské','Slovak'], DE:['německé','German'], FR:['francouzské','French'],
    ES:['španělské','Spanish'], IT:['italské','Italian'], PT:['portugalské','Portuguese'] };
  // Souvislé "hlášení" o subjektu — z dat ze všech panelů. Hodnoty se escapují,
  // zvýrazněné části jsou v <b>.
  function storyHTML(){
    var B = function(x){ return '<b>' + esc(x) + '</b>'; }, out = [];
    var gd = guessDevice(), d = (S.whoami && S.whoami !== false) ? S.whoami : null, v = vpnInfo();
    // zařízení
    if (gd) out.push(tr('Subjekt používá ' + B(gd.name) + ' (cena zhruba ' + esc(gd.price.replace(/^~/, '')) + ').',
                        'The subject uses ' + B(gd.name) + ' (worth roughly ' + esc(gd.price.replace(/^~/, '')) + ').'));
    else out.push(tr('Subjekt používá ' + B(guessOS()) + '.', 'The subject runs ' + B(guessOS()) + '.'));
    // poloha + připojení
    var place = null;
    if (S.precise && S.precise.address) place = S.precise.address;
    else if (d && d.geo){ var cn = d.geo.countryName ? d.geo.countryName[T()] : d.geo.country; place = [d.geo.city, cn].filter(Boolean).join(', '); }
    if (place){
      var isp = d && d.network && d.network.asOrganization;
      var s1 = tr('Připojuje se z místa ' + B(place), 'They connect from ' + B(place));
      if (v && v.hosting) s1 += tr(' přes VPN ' + esc(v.org), ' through the VPN ' + esc(v.org)) + (v.mismatch ? tr(' — hodiny prohlížeče ho ale prozrazují', ' — but their browser clock gives them away') : '');
      else if (isp) s1 += tr(' přes ' + esc(isp), ' via ' + esc(isp));
      out.push(s1 + (S.precise && S.precise.address ? tr(' (přesně podle GPS).', ' (exact, from GPS).') : '.'));
    }
    // jazyk + klávesnice
    var lang = (navigator.languages && navigator.languages[0]) || navigator.language;
    if (lang){
      var s2 = tr('Jazyk prohlížeče je ' + B(langName(lang.split('-')[0])), 'Their browser speaks ' + B(langName(lang.split('-')[0])));
      var k = S.kbd, ka = k && k.cc && KBD_ADJ[k.cc];
      if (ka) s2 += tr(', píše ale na ' + B(ka[0]) + ' klávesnici', ', but they type on a ' + B(ka[1]) + ' keyboard');
      out.push(s2 + '.');
    }
    // čas, baterie, nastavení
    var hh = new Date().toLocaleTimeString(T() === 'en' ? 'en-GB' : 'cs-CZ', { hour: '2-digit', minute: '2-digit' });
    var s3 = tr('Je u zařízení v ' + B(hh) + ' místního času', 'They are at the device at ' + B(hh) + ' local time');
    var bt = S.battery;
    if (bt && bt.level != null && !bt.plugged) s3 += tr(', baterii má na ' + B(bt.level + ' %') + (bt.charging ? ' a nabíjí' : ''), ', battery at ' + B(bt.level + '%') + (bt.charging ? ' and charging' : ''));
    if (mm('(prefers-color-scheme: dark)')) s3 += tr(', má zapnutý tmavý režim', ', with dark mode on');
    out.push(s3 + '.');
    // chování na stránce
    var b = S.behavior;
    if (b){
      var sec = Math.round((Date.now() - b.start) / 1000), t = sec < 60 ? sec + ' s' : Math.floor(sec / 60) + ' min ' + (sec % 60) + ' s';
      var s4 = tr('Na stránce je ' + B(t), 'They have been here for ' + B(t));
      if (b.away) s4 += tr(', ' + B(b.away + '×') + ' se podíval jinam', ', looked away ' + B(b.away + '×'));
      if (S.copied) s4 += tr(' a zkopíroval si „' + esc(S.copied) + '“', ' and copied "' + esc(S.copied) + '"');
      out.push(s4 + '.');
    }
    // návštěvy + anonymní okno
    if (S.sc && !S.sc.error){
      if (S.sc.visits > 1) out.push(tr('Byl tu už ' + B(S.sc.visits + '×') + (S.sc.lastVisit ? ', naposledy ' + esc(relTime(S.sc.lastVisit)) : '') + '.',
                                       'This is visit ' + B('#' + S.sc.visits) + (S.sc.lastVisit ? ', the last one ' + esc(relTime(S.sc.lastVisit)) : '') + '.'));
      else out.push(tr('Je tu poprvé. Příště ho poznáme.', 'First visit. We\'ll recognise them next time.'));
    }
    if (S.incognito === true) out.push(tr('Myslí si, že ho chrání anonymní okno.', 'They think incognito protects them.'));
    return out.join(' ');
  }
  function collectDossier(){
    S.dossierReady = true;
    if (!S.device) collectDevice();
    if (!S.browser) collectBrowser();
    if (!S.fp) collectFingerprint();
    if (!S.originReady) collectOrigin();
    collectMediaDevices();
    renderDossier();
    // hlášení obsahuje čas na stránce → drž ho živé
    if (!storyLoop) storyLoop = setInterval(function(){
      var st = document.getElementById('ds-story'); if (st) st.innerHTML = storyHTML();
    }, 1000);
  }
  var storyLoop = 0;

  // Sdílení — Web Share API, jinak zkopírovat odkaz. Nesdílí žádná data o tobě.
  function bindShare(){
    var btn = document.getElementById('share-btn'), note = document.getElementById('share-note');
    if (!btn) return;
    btn.addEventListener('click', function(){
      var url = 'https://www.igy.cz/?lang=' + T();
      var text = tr('Myslíš, že jsi na webu anonymní? Mrkni, co o tobě prohlížeč prozradí.',
                    'Think you\'re anonymous online? See what your browser gives away.');
      function copied(){ if (note) note.textContent = tr('Odkaz zkopírován — pošli ho dál.', 'Link copied — pass it on.'); }
      if (navigator.share){
        navigator.share({ title: 'I Google You', text: text, url: url }).catch(function(){});
      } else if (navigator.clipboard && navigator.clipboard.writeText){
        navigator.clipboard.writeText(url).then(copied, function(){ if (note) note.textContent = url; });
      } else if (note){ note.textContent = url; }
    });
  }
  function renderDossier(){
    var st = document.getElementById('ds-story'); if (st) st.innerHTML = storyHTML();
    setText('ds-code', (S.fp && S.fp.id) ? ('#' + S.fp.id) : '#········');
    var loc = '—';
    if (S.precise && (S.precise.address || S.precise.lat != null)){
      loc = (S.precise.address || (S.precise.lat.toFixed(5) + ', ' + S.precise.lon.toFixed(5))) + '  ·  GPS';
    } else if (S.whoami && S.whoami !== false && S.whoami.geo){
      var g = S.whoami.geo, cn = g.countryName ? g.countryName[T()] : g.country;
      loc = [g.city, cn].filter(Boolean).join(', ') || '—';
    } else if (S.originBest){ loc = CNAME[S.originBest] ? CNAME[S.originBest][T()] : S.originBest; }
    setText('ds-loc', loc);
    setText('ds-ip', (S.whoami && S.whoami !== false && S.whoami.ip) ? S.whoami.ip : tr('(jen na nasazeném webu)', '(only on deployed site)'));
    var gd = guessDevice();
    setText('ds-device', gd ? gd.name : guessOS());
    setText('ds-browser', guessBrowser() + ' · ' + guessEngine());
    setText('ds-fp', (S.fp && S.fp.id) ? S.fp.id : tr('počítám…', 'computing…'));
    var superTxt = '—';
    if (S.sc){ superTxt = S.sc.error ? tr('(jen na nasazeném webu)', '(only on deployed site)')
      : (S.sc.returning ? tr('ANO — poznán z cache', 'YES — recognized from cache') : tr('ID uloženo v cache', 'ID stored in cache')); }
    setText('ds-super', superTxt);

    var bits = trackBits();
    setText('ds-track', bits >= 20 ? tr('VYSOKÁ', 'HIGH') : bits >= 12 ? tr('STŘEDNÍ', 'MEDIUM') : tr('NÍZKÁ', 'LOW'));
    var oneIn = Math.pow(2, bits), nEl = document.getElementById('ds-track-note');
    if (nEl){
      if (oneIn > 8e9){
        nEl.textContent = tr('Z nasbíraných znaků poskládám otisk s ~' + bits + ' bity entropie — prakticky unikátní mezi všemi prohlížeči na světě.',
                             'The collected traits form a ~' + bits + '-bit fingerprint — practically unique among every browser on Earth.');
      } else {
        var x = Math.round(oneIn).toLocaleString();
        nEl.textContent = tr('Otisk má ~' + bits + ' bitů entropie — jsi zhruba 1 z ' + x + '.',
                             'The fingerprint carries ~' + bits + ' bits of entropy — you\'re roughly 1 in ' + x + '.');
      }
    }
  }

  // ===================== reveal při scrollu =====================
  function setupReveal(runners){
    var panels = document.querySelectorAll('[data-panel]');
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if (e.isIntersecting){
          e.target.classList.add('in');
          var run = e.target.getAttribute('data-run');
          if (run && runners[run] && !e.target.__ran){ e.target.__ran = true; runners[run](); }
          io.unobserve(e.target);
        }
      });
    // Odhal, jakmile panel vjede do horních 80 % okna. (Dřív threshold 0.25
    // poměru panelu — panel vyšší než 4× okno ho nikdy nedosáhl a zůstal skrytý.)
    }, { threshold: 0, rootMargin: '0px 0px -20% 0px' });
    panels.forEach(function(p){ io.observe(p); });
  }

  // přiřaď "runners" k panelům podle pořadí
  // 0 Síť · 1 Zařízení · 2 Prohlížeč · 3 Otisk · 4 Původ · 5 Chování · 6 Svolení · 7 Retro · 8 Spis
  var cards = document.querySelectorAll('[data-panel]');
  if (cards[1]) cards[1].setAttribute('data-run','device');
  if (cards[2]) cards[2].setAttribute('data-run','browser');
  if (cards[3]) cards[3].setAttribute('data-run','fp');
  if (cards[4]) cards[4].setAttribute('data-run','origin');
  if (cards[5]) cards[5].setAttribute('data-run','behavior');
  if (cards[6]) cards[6].setAttribute('data-run','perms');
  if (cards[8]) cards[8].setAttribute('data-run','dossier');

  // Přerenderuj vše jazykově závislé z uloženého stavu (při přepnutí CZ/EN).
  function rerenderAll(){
    renderNet();
    renderWebRTC();
    if (heroDone && !heroTyping) renderHeroFinal();
    if (S.device) renderDevice();
    if (S.browser) renderBrowser();
    if (S.fp) renderFpRows();
    if (S.sc) renderSupercookie();
    if (S.originReady) renderOrigin();
    if (S.behavior) renderBehavior();
    if (S.dossierReady) renderDossier();
  }

  function start(){
    initBehavior();
    // pro hero a spis potřebujeme tyhle hned, ne až po doscrollování
    collectBattery();
    collectKeyboard();
    collectIncognito();
    collectSupercookie();
    bindShare();
    setupReveal({ device: collectDevice, browser: collectBrowser, fp: collectFingerprint,
      origin: collectOrigin, behavior: collectBehavior, perms: bindPerms, dossier: collectDossier });
    window.onLangChange = rerenderAll; // Layout volá při přepnutí vlajky
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start);
  else start();
})();
</script>

</Layout>
