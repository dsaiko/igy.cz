    var dpr = Math.min(window.devicePixelRatio || 1, 2);
    var W = 760, H = 240;
    canvas.width = W * dpr; canvas.height = H * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    var cx = W / 2, cy = H / 2;

    function frame(t){
      ctx.clearRect(0, 0, W, H);   // průhledné → prosvítá mapa pod canvasem
      // pulzující kruhy
      var phase = (t % 2600) / 2600;
      for (var k = 0; k < 3; k++){
        var p = (phase + k / 3) % 1;
        ctx.beginPath(); ctx.arc(cx, cy, 20 + p * 96, 0, Math.PI * 2);
        ctx.strokeStyle = 'rgba(56,232,200,' + (0.5 * (1 - p)) + ')'; ctx.lineWidth = 1.5; ctx.stroke();
      }
