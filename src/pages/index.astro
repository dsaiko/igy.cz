      renderWebRTC();
      try { pc.close(); } catch(_){}
    }
    setTimeout(finish, 2500);
  }
  function renderWebRTC(){
    var w = S.webrtc; if (!w) return;
    if (w.unsupported){ set('rtc-local', tr('nepodporováno','unsupported')); set('rtc-public', tr('nepodporováno','unsupported')); return; }
    if (w.blocked){ set('rtc-local', tr('blokováno','blocked')); set('rtc-public', tr('blokováno','blocked')); return; }
    if (w.locals && w.locals.length) set('rtc-local', w.locals.join(', '), 'danger');
    else set('rtc-local', w.mdns ? tr('skryto (mDNS chrání)','hidden (mDNS protects)') : '—');
    var pub = w.publics && w.publics.length;
    set('rtc-public', pub ? w.publics.join(', ') : '—', pub ? 'danger' : '');
  }
  collectWebRTC();

  // ===================== HERO scan + personalizace =====================
  var scanEl = document.getElementById('scanline');
  var heroDone = false, heroTyping = false;

  function heroPlace(){ var h = S.hero || {}; return h.city || (h.cn ? h.cn[T()] : ''); }
  function heroLines(){
    return [ tr('> navazuji spojení…', '> establishing connection…'),
             tr('> mám tě.', '> got you.'),
             tr('> tohle vím, aniž jsi cokoli udělal:', '> here\'s what I know — and you did nothing:') ];
  }
  function showCue(){ var c = document.getElementById('scrollcue'); if (c) c.classList.add('show'); }
  function renderHeroFinal(){
    scanEl.innerHTML = heroLines().map(esc).join('<br>');
    renderHeroFacts();
  }
  // Velká personalizace hned na první obrazovce — většina lidí dál nescrolluje.
  var heroFactsKey = '';
  function heroFacts(){
    var f = [], h = S.hero || {}, place = heroPlace(), v = vpnInfo();
    if (place) f.push(['📍', place]);
    if (v && v.hosting) f.push(['🛡️', 'VPN · ' + v.org]);
    else if (h.isp) f.push(['📡', h.isp]);
