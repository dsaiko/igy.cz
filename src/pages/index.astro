      set('vpn', tr('ANO (' + v.org + ') — ale hodiny tě prozrazují', 'YES (' + v.org + ') — but your clock gives you away'), 'danger');
      if (sw) sw.textContent = tr('Schováváš se za ' + v.org + '. Jenže tvoje hodiny jdou podle ' + v.btz + ', ne podle ' + v.itz + ' — vím, že nejsi tam, kde tvrdí IP.',
